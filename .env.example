# Copy to .env and fill in. `.env` is git-ignored; this file is not, so never put
# a real value here.
#
# Generate the three keys below with something like:
#   openssl rand -base64 48
#   # or, without openssl:
#   dotnet user-secrets  ...   /  pwsh: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))

# ── Timezone ─────────────────────────────────────────────────────────────────
# The CMS renders stored UTC timestamps (logs, form submissions, dashboard) in this
# zone. Defaults to Europe/Istanbul; set it to your own IANA zone (e.g. Europe/Berlin,
# America/New_York) so admin-panel times match your wall clock.
TZ=Europe/Istanbul

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=elevare
POSTGRES_PASSWORD=
DB_NAME=ElevareDB

# ── Secrets ──────────────────────────────────────────────────────────────────
# Signs admin sessions. At least 32 characters — the CMS refuses to start below that.
JWT_SECRET=
# Signs "preview unpublished page" links (a JWT). The CMS and the site must share
# it. At least 32 characters — HMAC-SHA256 needs a 256-bit key, and preview links
# simply fail to generate below that.
PREVIEW_SIGNING_KEY=
# Authorises the CMS's "clear the site cache" calls. Both apps must share it, and
# it must not be empty — an empty value means the site rejects every clear request.
CACHE_CLEAR_SECRET=

# ── First administrator ──────────────────────────────────────────────────────
# Created once, on the first run against an empty database. Changing these later
# does not rename or re-password the existing account — do that in the CMS.
ADMIN_USERNAME=superadmin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Ports on the host ────────────────────────────────────────────────────────
# If you already run PostgreSQL or Redis locally, change DB_PORT / REDIS_PORT —
# otherwise the container cannot bind and `localhost:5432` becomes ambiguous
# (tools pointed at the local instance will silently reach the container instead).
CMS_PORT=5150
WEB_PORT=5160
DB_PORT=5432
REDIS_PORT=6379

# ── Optional ─────────────────────────────────────────────────────────────────
JWT_ISSUER=http://localhost:5150
JWT_AUDIENCE=http://localhost:5150
REDIS_CONNECTION=cache:6379

# ── E-mail, CAPTCHA, S3/CDN (all optional — and all skippable now) ───────────
# You don't have to fill any of this in here at all. Log into the CMS once (as
# the admin above) and use the "Sırlar" screen (Site Settings → Secrets) to enter
# SMTP, CAPTCHA and S3/CDN credentials instead — they're stored encrypted in the
# database and take effect live, no restart. The variables below only matter as a
# deploy-time FALLBACK for a hands-off/CI setup; whichever source has a value
# wins, and the database wins when both do.
#
# For local testing without a real mailbox, run with docker-compose.dev-tools.yml
# layered on top instead of filling the SMTP ones in — see that file's header.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_DISPLAY_NAME=CMS

# Pairs with Integrations.CaptchaProvider/CaptchaSiteKey, chosen in Site Settings
# (safe to expose). Captcha stays off until BOTH a provider is picked there AND
# a secret key is set somewhere (here, or in "Sırlar").
CAPTCHA_SECRET_KEY=

# S3-compatible object storage — leave Provider as "Local" (or unset) to keep
# serving uploads from disk, exactly as before.
OBJECT_STORAGE_PROVIDER=Local
OBJECT_STORAGE_BUCKET_NAME=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Only for non-AWS S3-compatible services (MinIO, DigitalOcean Spaces, Cloudflare
# R2, etc.) — leave empty for AWS.
OBJECT_STORAGE_SERVICE_URL=
# A CDN or custom domain fronting the bucket, if you have one.
OBJECT_STORAGE_PUBLIC_BASE_URL=

# ── Structured logging ───────────────────────────────────────────────────────
# Where to ship Serilog's structured logs, if anywhere. Leave empty and the
# console stays the only sink — which is what `docker compose logs` shows, and is
# a complete setup on its own. Set it to a Seq address (yours, or the one the
# dev-tools stack below starts) to get searchable logs. The sink is registered
# only when this has a value, so an empty one costs nothing.
SEQ_URL=
SEQ_API_KEY=

# ── Local dev-tools ports (only used with docker-compose.dev-tools.yml) ──────
MAILPIT_UI_PORT=8025
SEQ_UI_PORT=5341
