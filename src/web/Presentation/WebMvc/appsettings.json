{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "SeqUrl": "",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ElevareDB;Username=postgres;Password=postgres;"
  },
  "Preview": {
    "SigningKey": ""
  },
  "Captcha": {
    "SecretKey": ""
  },
  "Cache": {
    "ClearSecret": ""
  },
  "RateLimiting": {
    "Enabled": true,
    "TrustForwardedForHeader": false,
    "WindowSeconds": 60,
    "FormSubmitPermitLimit": 10,
    "SearchPermitLimit": 120,
    "TelemetryPermitLimit": 300,
    "ClientLogPermitLimit": 30,
    "CacheAdminPermitLimit": 20
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379,allowAdmin=true"
  }
}
