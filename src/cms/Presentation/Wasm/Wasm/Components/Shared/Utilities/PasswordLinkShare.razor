@* A password link for the administrator to pass on themselves — the way in on a
   site with no mail server. Shown once, right after it is made: the database only
   keeps the link's hash, so it cannot be shown again later, only replaced. *@

<div>
    @if (EmailFailed)
    {
        <div class="pw-link-note is-warning">
            <i class="bi bi-envelope-x"></i>
            <span>@L["PasswordLink_EmailFailed"]</span>
        </div>
    }
    <p style="margin:0 0 10px;font-size:13.5px;color:var(--cms-text)">
        @string.Format(L["PasswordLink_Intro"], UserName)
    </p>
    <div style="display:flex;gap:8px;align-items:stretch">
        <input id="@_inputId" class="cms-input" readonly value="@Url"
               style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px" />
        @* Copied by the delegated listener in cms.js, inside the real click — see
           installCopyDelegation for why a Blazor @onclick cannot do it. *@
        <button type="button" class="btn-cms btn-primary-cms" style="flex-shrink:0"
                data-copy-target="#@_inputId"
                data-copy-idle-label="@L["PasswordLink_Copy"]"
                data-copied-label="@L["PasswordLink_Copied"]"
                data-copyfail-label="@L["PasswordLink_CopyFailed"]">
            <i class="bi bi-clipboard"></i>
            <span data-copy-label>@L["PasswordLink_Copy"]</span>
        </button>
    </div>
    <ul style="margin:12px 0 0;padding-left:18px;font-size:12.5px;color:var(--cms-text-muted);line-height:1.7">
        <li>@string.Format(L["PasswordLink_Expires"], ExpiresAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))</li>
        <li>@L["PasswordLink_OneTime"]</li>
        <li><strong>@L["PasswordLink_Private"]</strong></li>
    </ul>
</div>

@code {
    // CA1056: shown to be copied, never parsed.
#pragma warning disable CA1056
    [Parameter, EditorRequired] public string Url { get; set; } = "";
#pragma warning restore CA1056
    [Parameter] public DateTime ExpiresAtUtc { get; set; }
    [Parameter] public string UserName { get; set; } = "";

    /// <summary>Mail was asked for and did not go out — said first, so the link is not mistaken for a duplicate.</summary>
    [Parameter] public bool EmailFailed { get; set; }

    private readonly string _inputId = $"pw-link-{Guid.NewGuid():N}";
}
