    <details class="guide-section" id="brand-colors-guide">
        <summary>@L["Guide_BrandColorsTitle"]</summary>
        <div class="guide-section-body">
            <p style="margin:0 0 12px;color:var(--cms-text-muted)">@L["Guide_BrandColorsIntro"]</p>
            <ol style="padding-left:20px;margin:0 0 20px">
                <li>@L["Guide_BrandColorsStep1"]</li>
                <li>@L["Guide_BrandColorsStep2"]</li>
                <li>@L["Guide_BrandColorsStep3"]</li>
            </ol>
            <p style="margin:0 0 6px;font-weight:600">@L["Guide_BrandColorsA11yTitle"]</p>
            <p style="margin:0 0 12px;color:var(--cms-text-muted)">@L["Guide_BrandColorsA11yBody"]</p>
            <p style="margin:0 0 16px;color:var(--cms-text-muted)">@L["Guide_BrandColorsWarning"]</p>

            @* The whole palette, not a snippet: editing these by hand is the one way
               a site can lose a variable entirely, and a half-palette fails in a way
               that is hard to read back from the page — a block quietly falls to the
               fallback baked into its own markup instead of showing an error. Having
               the complete known-good set one click away turns that from a debugging
               session into a paste. Values are the seeded defaults, so this doubles
               as "put it back the way it came". *@
            <p style="margin:0 0 6px;font-weight:600">@L["Guide_BrandColorsTemplateTitle"]</p>
            <p style="margin:0 0 8px;color:var(--cms-text-muted)">@L["Guide_BrandColorsTemplateBody"]</p>
            <textarea id="brand-colors-template" class="cms-input" rows="10" readonly style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;white-space:pre">:root {
  --elevare-bg: #ffffff;         /* sayfa zemini */
  --elevare-surface: #f5f5f5;    /* kart, panel, menü zemini */
  --elevare-surface-2: #eeeeee;  /* ikincil buton, rozet zemini */
  --elevare-text: #111111;       /* gövde metni */
  --elevare-text-2: #333333;     /* ikincil metin */
  --elevare-muted: #666666;      /* tarih, etiket, ayraç */
  --elevare-border: #dddddd;     /* çerçeve ve ayraç çizgileri */
  --elevare-primary: #000000;    /* vurgu rengi, birincil buton zemini */
  --elevare-on-primary: #ffffff; /* birincil zeminin ÜSTÜNDEKİ yazı */
  --elevare-secondary: #404040;  /* ikincil vurgu */
  --elevare-heading: #111111;    /* başlıklar */
  --elevare-link: #000000;       /* bağlantılar */
  --elevare-code-bg: #1a1a1a;    /* kod bloğu zemini */
}
[data-theme="dark"] {
  --elevare-bg: #0d0d0d;
  --elevare-surface: #1a1a1a;
  --elevare-surface-2: #242424;
  --elevare-text: #f5f5f5;
  --elevare-text-2: #cccccc;
  --elevare-muted: #999999;
  --elevare-border: #333333;
  --elevare-primary: #ffffff;
  --elevare-on-primary: #111111;
  --elevare-secondary: #bfbfbf;
  --elevare-heading: #f5f5f5;
  --elevare-link: #ffffff;
  --elevare-code-bg: #0a0a0a;
}</textarea>
            @* Copied by a delegated listener in cms.js inside the real click — a
               Blazor round trip would land outside the user gesture and the browser
               would reject the clipboard write. Same mechanism as the JSON builder. *@
            <button type="button" class="btn-cms btn-primary-cms btn-sm-cms" style="margin-top:8px"
                    data-copy-target="#brand-colors-template"
                    data-copy-idle-label="@L["Guide_BrandColorsTemplateCopy"]"
                    data-copied-label="@L["Guide_BrandColorsTemplateCopied"]"
                    data-copyfail-label="@L["Guide_BrandColorsTemplateCopyFailed"]">
                <i class="bi bi-clipboard"></i>
                <span data-copy-label>@L["Guide_BrandColorsTemplateCopy"]</span>
            </button>
            <p style="margin:12px 0 0;color:var(--cms-text-muted)">@L["Guide_BrandColorsTemplateNote"]</p>
        </div>
    </details>

