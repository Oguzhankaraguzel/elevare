                <li><strong>@L["Guide_LayoutRightTitle"]</strong> — @L["Guide_LayoutRightBody"]</li>
                <li><strong>@L["Guide_LayoutTextTitle"]</strong> — @L["Guide_LayoutTextBody"]</li>
                <li><strong>@L["Guide_LayoutSettingsTitle"]</strong> — @L["Guide_LayoutSettingsBody"]</li>
            </ul>
            <p style="margin:0;color:var(--cms-text-muted)">@L["Guide_LayoutRule"]</p>
        </div>
    </details>
