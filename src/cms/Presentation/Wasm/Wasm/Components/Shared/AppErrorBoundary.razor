@using Microsoft.Extensions.Logging
@inject ILogger<AppErrorBoundary> Logger
@inherits ErrorBoundaryBase

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <div style="padding:16px;color:var(--cms-danger);">@L["Error_Occurred"]</div>
}

@code {
    // ChildContent is inherited from ErrorBoundaryBase - do not redeclare.

    protected override Task OnErrorAsync(Exception exception)
    {
        try
        {
            Logger.LogError(exception, "Unhandled component exception");
            if (Toast is not null)
                Toast.Error(exception.Message ?? L["Error_Unknown"]);
        }
        catch
        {
            // ignore logging errors
        }

        return Task.CompletedTask;
    }
}
