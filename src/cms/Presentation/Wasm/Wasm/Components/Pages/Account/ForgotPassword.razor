@page "/account/forgot-password"
@layout AuthLayout
@attribute [AllowAnonymous]

<CmsPageTitle>@L["Forgot_PageTitle"]</CmsPageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img class="login-logo__mark" src="img/elevare-mark.png" alt="Elevare" />
            <h1>@L["Forgot_Title"]</h1>
            @if (_emailConfigured == true)
            {
                <p>@L["Forgot_Subtitle"]</p>
            }
        </div>

        @if (Sent)
        {
            @* The same words whatever happened — see the endpoint in AuthEndpoints. *@
            <div class="pw-link-note" style="margin-bottom:20px">
                <i class="bi bi-envelope-check"></i>
                <span>@L["Forgot_Sent"]</span>
            </div>
        }
        else if (_emailConfigured == false)
        {
            <div class="pw-link-note is-warning" style="margin-bottom:20px">
                <i class="bi bi-person-gear"></i>
                <span>@L["Forgot_NoMail"]</span>
            </div>
        }
        else if (_emailConfigured == true)
        {
            @* A plain form post, like sign-in: the rate limiter only sees HTTP requests. *@
            <form method="post" action="/account/forgot-password/send" id="forgot-form">
                <div class="form-group">
                    <label class="cms-label" for="forgot-identifier">@L["Login_IdentifierLabel"]</label>
                    <input id="forgot-identifier" name="identifier" type="text" required class="cms-input"
                           placeholder="@L["Login_IdentifierPlaceholder"]" autocomplete="username" />
                </div>
                <button type="submit" id="forgot-submit" class="btn-cms btn-primary-cms w-100"
                        style="justify-content:center;padding:11px;font-size:14px">
                    <i class="bi bi-envelope-arrow-up"></i>
                    <span>@L["Forgot_SubmitBtn"]</span>
                </button>
            </form>
            <script>
                document.getElementById('forgot-form').addEventListener('submit', function () {
                    document.getElementById('forgot-submit').disabled = true;
                });
            </script>
        }

        <a href="/login" class="btn-cms btn-ghost w-100" style="justify-content:center;margin-top:12px">
            <i class="bi bi-arrow-left"></i> @L["Forgot_BackToLogin"]
        </a>

        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:24px">
            <span style="font-size:12px;color:var(--cms-text-dim)">Elevare CMS &copy; @DateTime.Now.Year</span>
            <LanguageSwitcher />
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "sent")]
    private int? SentFlag { get; set; }

    private bool Sent => SentFlag == 1;

    private bool? _emailConfigured;

    protected override async Task OnInitializedAsync()
    {
        if (Sent) return;
        (await Sender.Send(new GetEmailStatusQuery())).Match(configured => _emailConfigured = configured, _ => _emailConfigured = false);
    }
}
