@page "/account/set-password"
@layout AuthLayout
@attribute [AllowAnonymous]

<CmsPageTitle>@L["SetPassword_PageTitle"]</CmsPageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img class="login-logo__mark" src="img/elevare-mark.png" alt="Elevare" />
            <h1>Elevare CMS</h1>
            <p>@L["SetPassword_Subtitle"]</p>
        </div>

        @if (string.IsNullOrWhiteSpace(Token))
        {
            <div style="background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);border-radius:8px;padding:12px 14px;font-size:13.5px;color:var(--cms-danger);display:flex;align-items:center;gap:8px">
                <i class="bi bi-exclamation-circle-fill"></i>
                @L["SetPassword_MissingToken"]
            </div>
        }
        else if (_done)
        {
            <div style="background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.25);border-radius:8px;padding:12px 14px;font-size:13.5px;color:var(--cms-success);display:flex;align-items:center;gap:8px;margin-bottom:20px">
                <i class="bi bi-check-circle-fill"></i>
                @L["SetPassword_Success"]
            </div>
            <a href="/login" class="btn-cms btn-primary-cms w-100" style="justify-content:center;padding:11px;font-size:14px">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>@L["SetPassword_GoToLoginBtn"]</span>
            </a>
        }
        else
        {
            @if (_errorMessage is not null)
            {
                <div style="background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.25);border-radius:8px;padding:12px 14px;margin-bottom:20px;font-size:13.5px;color:var(--cms-danger);display:flex;align-items:center;gap:8px">
                    <i class="bi bi-exclamation-circle-fill"></i>
                    @_errorMessage
                </div>
            }

            <EditForm Model="_model" OnValidSubmit="Submit">
                <div class="form-group">
                    <label class="cms-label">@L["SetPassword_NewLabel"]</label>
                    <input class="cms-input" type="password" @bind="_model.NewPassword" @bind:event="oninput"
                           placeholder="@L["SetPassword_NewPlaceholder"]" autocomplete="new-password" />
                </div>

                <div class="form-group">
                    <label class="cms-label">@L["SetPassword_ConfirmLabel"]</label>
                    <input class="cms-input" type="password" @bind="_model.ConfirmPassword" @bind:event="oninput"
                           placeholder="@L["SetPassword_NewPlaceholder"]" autocomplete="new-password" />
                </div>

                <button type="submit" class="btn-cms btn-primary-cms w-100" style="justify-content:center;padding:11px;font-size:14px" disabled="@_submitting">
                    @if (_submitting) { <i class="bi bi-arrow-clockwise spin"></i> } else { <i class="bi bi-check2"></i> }
                    <span>@L["SetPassword_SubmitBtn"]</span>
                </button>
            </EditForm>
        }

        <div style="display:flex;align-items:center;justify-content:space-between;margin-top:24px">
            <span style="font-size:12px;color:var(--cms-text-dim)">Elevare CMS &copy; @DateTime.Now.Year</span>
            <LanguageSwitcher />
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private readonly FormModel _model = new();
    private bool _submitting;
    private bool _done;
    private string? _errorMessage;

    private async Task Submit()
    {
        _errorMessage = null;

        if (_model.NewPassword.Length < 8)
        {
            _errorMessage = L["SetPassword_TooShort"];
            return;
        }

        if (!string.Equals(_model.NewPassword, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _errorMessage = L["SetPassword_Mismatch"];
            return;
        }

        _submitting = true;
        try
        {
            Result r = await Sender.Send(new SetPasswordCommand(Token!, _model.NewPassword));
            if (r.IsSuccess)
            {
                _done = true;
            }
            else
            {
                _errorMessage = L.Error(r.Error);
            }
        }
        finally { _submitting = false; }
    }

    private sealed class FormModel
    {
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }
}
