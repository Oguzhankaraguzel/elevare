@page "/pages"
@layout CMSLayout

<PageTitle>@L["Pages_PageTitle"]</PageTitle>

<div class="page-header">
    <div style="display:flex;align-items:center;justify-content:space-between">
        <div>
            <h1>@L["Pages_Title"]</h1>
            <p>@L["Pages_Subtitle"]</p>
            <button type="button" class="pe-slug-hint-btn" @onclick="() => _showSlugInfo = true">
                <i class="bi bi-info-circle"></i> @L["Pages_SystemSlugHint"]
            </button>
        </div>
        <div style="display:flex;align-items:center;gap:10px">
            @* Filters live here, next to Yeni Sayfa — not in the view-mode row below,
               where they used to sit alongside Düz Liste/Ağaç Görünümü as if they were
               a third view. They are a modifier of whichever view is showing, not a
               view of their own, so they get their own spot. *@
            <button type="button" class="btn-cms btn-ghost @(_filterPanelOpen ? "pe-filter-btn-active" : "")" @onclick="() => _filterPanelOpen = !_filterPanelOpen">
                <i class="bi bi-funnel"></i> @L["Pages_Filters"]
                @if (ActiveFilterCount > 0)
                {
                    <span class="pe-filter-count">@ActiveFilterCount</span>
                }
            </button>
            <button class="btn-cms btn-primary-cms" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> @L["Pages_New"]
            </button>
        </div>
    </div>
</div>

<div class="pe-toggle-row">
    <div class="pe-view-toggle">
        <button type="button" class="pe-view-toggle-btn @(_viewMode == PageViewMode.Flat ? "active" : "")" @onclick='() => _viewMode = PageViewMode.Flat'>
            <i class="bi bi-list-ul"></i> @L["Pages_ViewFlat"]
        </button>
        <button type="button" class="pe-view-toggle-btn @(_viewMode == PageViewMode.Tree ? "active" : "")" @onclick='() => _viewMode = PageViewMode.Tree'>
            <i class="bi bi-diagram-3"></i> @L["Pages_ViewTree"]
        </button>
    </div>
    @* Grouped: one row per page, every language stacked together — the natural unit
       an editor thinks in ("the About page", not "the About page in Turkish").
       Individual: one row per language version, for when you need to act on (or
       just count) each translation on its own. Applies to whichever tab above is
       active, so it works the same in both List and Tree. *@
    <div class="pe-view-toggle" title="@L["Pages_LayoutModeHint"]">
        <button type="button" class="pe-view-toggle-btn @(_layoutMode == PageLayoutMode.Grouped ? "active" : "")" @onclick='() => _layoutMode = PageLayoutMode.Grouped'>
            <i class="bi bi-layers"></i> @L["Pages_LayoutGrouped"]
        </button>
        <button type="button" class="pe-view-toggle-btn @(_layoutMode == PageLayoutMode.Individual ? "active" : "")" @onclick='() => _layoutMode = PageLayoutMode.Individual'>
            <i class="bi bi-file-earmark-text"></i> @L["Pages_LayoutIndividual"]
        </button>
    </div>
</div>

@if (_filterPanelOpen)
{
    <div class="cms-card pe-filter-panel">
        <p class="pe-filter-intro">@L["Pages_FiltersIntro"]</p>

        <div class="pe-filter-row">
            <div class="pe-filter-group">
                <label>@L["Pages_FilterStatus"]</label>
                <select class="cms-input" @bind="_filterStatus" @bind:after="LoadPages">
                    <option value="">@L["Pages_FilterAny"]</option>
                    <option value="@PageStatus.Draft">@L["Pages_StatusDraft"]</option>
                    <option value="@PageStatus.Published">@L["Pages_StatusPublished"]</option>
                    <option value="@PageStatus.Archived">@L["Pages_StatusArchived"]</option>
                </select>
            </div>
            <div class="pe-filter-group">
                <label>@L["Pages_FilterLanguage"]</label>
                <select class="cms-input" @bind="_filterLanguageId" @bind:after="LoadPages">
                    <option value="">@L["Pages_FilterAny"]</option>
                    @foreach (LanguageResponse lang in _languages)
                    {
                        <option value="@lang.Id">@lang.NameInNative</option>
                    }
                </select>
            </div>
        </div>

        @* Include-only, no exclude mode: "not a landing page" is expressed by
           leaving landing page unticked, which is one concept for the reader
           instead of two. *@
        <div class="pe-filter-block">
            <label>@L["Pages_FilterKind"]</label>
            <span class="pe-filter-hint">@L["Pages_FilterKindHint"]</span>
            <div class="pe-chip-row">
                @foreach (PageKind kind in AllPageKinds)
                {
                    bool on = _filterKinds.Contains(kind);
                    <button type="button" class="pe-chip @(on ? "pe-chip-on" : "")" @onclick="() => ToggleKind(kind)">
                        @L[$"PageKind_{kind}"]
                    </button>
                }
            </div>
        </div>

        <div class="pe-filter-block">
            <label>@L["Pages_FilterSignals"]</label>
            <span class="pe-filter-hint">@L["Pages_FilterSignalsHint"]</span>
            <div class="pe-chip-row">
                @foreach (PageSignal signal in FilterableSignals)
                {
                    bool on = _filterSignals.HasFlag(signal);
                    <button type="button" class="pe-chip @(on ? "pe-chip-on" : "")" @onclick="() => ToggleSignal(signal)">
                        @L[$"PageSignal_{signal}"]
                    </button>
                }
            </div>
        </div>

        @if (ActiveFilterCount > 0)
        {
            <div class="pe-filter-footer">
                <span>@string.Format(L["Pages_FilterResultCount"], _pages.Count)</span>
                <button type="button" class="btn-cms btn-ghost btn-sm-cms" @onclick="ClearFilters">
                    <i class="bi bi-x-lg"></i> @L["Pages_FilterClear"]
                </button>
            </div>
        }
    </div>
}

@if (_viewMode == PageViewMode.Flat && _layoutMode == PageLayoutMode.Grouped)
{
    <ElevareGrid TItem="PageListItemResponse"
                 Data="_pages"
                 Loading="_loading"
                 Title="@L["Pages_Title"]"
                 Columns="_columns"
                 ActionTemplate="_actionTemplate"
                 ShowRowNumbers
                 ShowImport="false"
                 EmptyText="@L["Pages_Empty"]"
                 PageSize="20" />
}
else if (_viewMode == PageViewMode.Flat && _layoutMode == PageLayoutMode.Individual)
{
    <ElevareGrid TItem="PageListItemResponse"
                 Data="_allItems"
                 Loading="_loading"
                 Title="@L["Pages_Title"]"
                 Columns="_individualColumns"
                 ActionTemplate="_individualActionTemplate"
                 ShowRowNumbers
                 ShowImport="false"
                 EmptyText="@L["Pages_Empty"]"
                 PageSize="20" />
}
else if (_loading)
{
    <div class="cms-card" style="display:flex;justify-content:center;padding:40px;color:var(--cms-text-muted)">
        <i class="bi bi-arrow-clockwise spin" style="font-size:24px"></i>
    </div>
}
else if (_layoutMode == PageLayoutMode.Grouped)
{
    <div class="cms-card pe-tree-card">
        @if (_treeRoots.Count == 0)
        {
            <div style="text-align:center;padding:60px;color:var(--cms-text-muted)">@L["Pages_Empty"]</div>
        }
        else
        {
            @foreach (PageListItemResponse root in _treeRoots)
            {
                @TreeNode(root, 0)
            }
        }
    </div>
}
else
{
    <div class="cms-card pe-tree-card">
        @if (_treeRootsIndividual.Count == 0)
        {
            <div style="text-align:center;padding:60px;color:var(--cms-text-muted)">@L["Pages_Empty"]</div>
        }
        else
        {
            @foreach (PageListItemResponse root in _treeRootsIndividual)
            {
                @IndividualTreeNode(root, 0)
            }
        }
    </div>
}

@* ── Reserved slug info modal ────────────────────────────────────────────── *@
<CmsModal Title="@L["Pages_SystemSlugInfoTitle"]" IsVisible="_showSlugInfo" OnClose="() => _showSlugInfo = false" Size="md">
    <Body>
        <p>@L["Pages_SystemSlugInfoWhat"]</p>
        <p>@L["Pages_SystemSlugInfoHow"]</p>
        <p style="color:var(--cms-warning)"><i class="bi bi-exclamation-triangle"></i> @L["Pages_SystemSlugInfoLanguage"]</p>
        <p>@L["Pages_SystemSlugInfoWhen"]</p>
        <p style="color:var(--cms-text-muted);font-size:13px">@L["Pages_SystemSlugInfoFallback"]</p>
        <div class="pe-slug-example">
            <strong><i class="bi bi-lightbulb"></i> @L["Pages_SystemSlugInfoExampleTitle"]</strong>
            <p>@L["Pages_SystemSlugInfoExample"]</p>
        </div>
    </Body>
    <Footer>
        <button class="btn-cms btn-primary-cms" @onclick="() => _showSlugInfo = false">@L["Common_Close"]</button>
    </Footer>
</CmsModal>

@* ── Deleted twin found ──────────────────────────────────────────────────── *@
@* Two different intentions used to share one button: "bring back what I deleted"
   and "start this translation over". Asking makes the choice explicit, and it is
   what stops a delete/recreate loop from leaving a pile of tombstones nobody can
   restore. *@
<CmsModal Title="@L["Pages_DeletedTwinTitle"]" IsVisible="@(_deletedTwin is not null)"
          OnClose="() => { _deletedTwin = null; _pendingTranslation = null; }" Size="md">
    <Body>
        @if (_deletedTwin is { } twin)
        {
            <p>@string.Format(L["Pages_DeletedTwinIntro"], twin.Title ?? twin.Slug)</p>
            <ul style="font-size:13px;color:var(--cms-text-muted);line-height:1.9;margin:0 0 4px 18px">
                <li>@string.Format(L["Pages_DeletedTwinWhen"],
                        twin.DeletedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "—")</li>
                @if (twin.DeletedByName is { } who)
                {
                    <li>@string.Format(L["Pages_DeletedTwinWho"], who)</li>
                }
            </ul>
            <p style="font-size:13px;color:var(--cms-text-muted)">@L["Pages_DeletedTwinExplain"]</p>
        }
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="() => { _deletedTwin = null; _pendingTranslation = null; }">
            @L["Pages_CancelBtn"]
        </button>
        <button class="btn-cms btn-ghost" @onclick="CreateFreshOverTwin">
            <i class="bi bi-file-earmark-plus"></i> @L["Pages_DeletedTwinFresh"]
        </button>
        <button class="btn-cms btn-primary-cms" @onclick="RestoreDeletedTwin">
            <i class="bi bi-arrow-counterclockwise"></i> @L["Pages_DeletedTwinRestore"]
        </button>
    </Footer>
</CmsModal>

@* ── Create modal ────────────────────────────────────────────────────────── *@
<CmsModal Title="@L["Pages_CreateTitle"]" IsVisible="_showCreate" OnClose="CloseCreate" Size="md">
    <Body>
        <div class="form-group">
            <label class="cms-label">@L["Pages_FieldTitle"] <span style="color:var(--cms-danger)">*</span></label>
            <input @bind="_createTitle" @bind:event="oninput" class="cms-input" placeholder="@L["Pages_FieldTitlePlaceholder"]" />
        </div>
        <div class="form-group">
            <label class="cms-label">@L["Pages_FieldSlug"]</label>
            <input @bind="_createSlug" class="cms-input" placeholder="@(_createTitle.HasValue() ? _createTitle.ToSlug() : "")" />
            <small style="color:var(--cms-text-muted);font-size:12px">@L["Pages_FieldSlugHint"]</small>
        </div>
        <div class="form-group">
            <label class="cms-label">@L["Pages_FieldLanguage"] <span style="color:var(--cms-danger)">*</span></label>
            <select @bind="_createLanguageId" class="cms-input">
                <option value="0">—</option>
                @foreach (LanguageResponse lang in _languages)
                {
                    <option value="@lang.Id">@lang.NameInNative</option>
                }
            </select>
        </div>
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="CloseCreate">@L["Pages_CancelBtn"]</button>
        <button class="btn-cms btn-primary-cms" @onclick="ConfirmCreate" disabled="@_saving">
            @if (_saving)
            {
                <i class="bi bi-arrow-clockwise spin"></i>
            }
            else
            {
                <i class="bi bi-check2"></i>
            }
            @L["Pages_CreateBtn"]
        </button>
    </Footer>
</CmsModal>

@* ── Delete modal (scoped to ONE language version, never the whole group) ── *@
<CmsModal Title="@L["Pages_DeleteTitle"]" IsVisible="_showDelete" OnClose="() => _showDelete = false" Size="sm">
    <Body>
        <div style="text-align:center;padding:8px 0">
            <i class="bi bi-exclamation-triangle-fill" style="font-size:36px;color:var(--cms-warning);display:block;margin-bottom:12px"></i>
            <p style="color:var(--cms-text)">@string.Format(L["Pages_DeleteLanguageConfirm"], _deleteTarget?.Title ?? "", _deleteTargetLanguage?.NameInNative ?? "")</p>
            @* Deleting a page is a soft delete: the row keeps IsDeleted and shows up in
               the Trash with a Restore button. Saying "cannot be undone" here was simply
               untrue, and it hid the Trash from the people most likely to need it. *@
            <p style="font-size:13px;color:var(--cms-text-muted)">@L["Pages_DeleteGoesToTrash"]</p>
        </div>
        @if (_deleteTarget?.Status == PageStatus.Published)
        {
            <div class="form-group" style="margin-top:12px;text-align:left">
                <label class="cms-label">@L["Pages_RedirectUrlLabel"]</label>
                <input @bind="_deleteRedirectUrl" @bind:event="oninput" class="cms-input" placeholder="@L["Pages_RedirectUrlPlaceholder"]" />
                <small style="color:var(--cms-text-muted);font-size:12px">@L["Pages_RedirectUrlHint"]</small>
            </div>
        }
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="() => _showDelete = false">@L["Pages_CancelBtn"]</button>
        <button class="btn-cms btn-danger-cms" @onclick="ConfirmDelete" disabled="@_saving">
            @if (_saving)
            {
                <i class="bi bi-arrow-clockwise spin"></i>
            }
            else
            {
                <i class="bi bi-trash3"></i>
            }
            @L["Common_Delete"]
        </button>
    </Footer>
</CmsModal>

@* ── Status-change redirect prompt (only shown when leaving Published) ──── *@
<CmsModal Title="@L["Pages_RedirectUrlLabel"]" IsVisible="_showStatusRedirectPrompt" OnClose="CancelStatusRedirectPrompt" Size="sm">
    <Body>
        <p style="color:var(--cms-text)">@L["Pages_StatusRedirectPrompt"]</p>
        <div class="form-group" style="margin-top:12px;text-align:left">
            <label class="cms-label">@L["Pages_RedirectUrlLabel"]</label>
            <input @bind="_statusRedirectUrl" @bind:event="oninput" class="cms-input" placeholder="@L["Pages_RedirectUrlPlaceholder"]" />
            <small style="color:var(--cms-text-muted);font-size:12px">@L["Pages_RedirectUrlHint"]</small>
        </div>
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="CancelStatusRedirectPrompt">@L["Pages_CancelBtn"]</button>
        <button class="btn-cms btn-primary-cms" @onclick="ConfirmStatusRedirectPrompt" disabled="@_saving">
            @if (_saving)
            {
                <i class="bi bi-arrow-clockwise spin"></i>
            }
            else
            {
                <i class="bi bi-check2"></i>
            }
            @L["Common_Confirm"]
        </button>
    </Footer>
</CmsModal>

@* ── Per-page stats popover ────────────────────────────────────────────── *@
<CmsModal Title="@L["Pages_StatsTitle"]" IsVisible="_showStats" OnClose="() => _showStats = false" Size="sm">
    <Body>
        @if (_statsLoading)
        {
            <div style="display:flex;justify-content:center;padding:24px"><i class="bi bi-arrow-clockwise spin"></i></div>
        }
        else if (_statsData is not null)
        {
            <div class="pe-stats-grid">
                <div class="pe-stats-item">
                    <span class="pe-stats-label">@L["Pages_Stats_SeoScore"]</span>
                    @if (_statsData.SeoScore.HasValue)
                    {
                        <span class="pe-stats-value" style="color:@ScoreColor(_statsData.SeoScore.Value)">@_statsData.SeoScore</span>
                    }
                    else
                    {
                        <span class="pe-stats-value pe-stats-value-muted">@L["Pages_Stats_SeoScoreNone"]</span>
                    }
                </div>
                <div class="pe-stats-item">
                    <span class="pe-stats-label">@L["Pages_Stats_TotalViews"]</span>
                    <span class="pe-stats-value">@_statsData.TotalViews</span>
                </div>
                <div class="pe-stats-item">
                    <span class="pe-stats-label">@L["Pages_Stats_UniqueVisitors"]</span>
                    <span class="pe-stats-value">@_statsData.UniqueVisitors</span>
                </div>
                <div class="pe-stats-item">
                    <span class="pe-stats-label">@L["Pages_Stats_AvgDuration"]</span>
                    <span class="pe-stats-value">@FormatDuration(_statsData.AvgDurationSeconds)</span>
                </div>
                <div class="pe-stats-item">
                    <span class="pe-stats-label">@L["Pages_Stats_TotalClicks"]</span>
                    <span class="pe-stats-value">@_statsData.TotalClicks</span>
                </div>
            </div>
        }
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="() => _showStats = false">@L["Common_Close"]</button>
    </Footer>
</CmsModal>

<style>
    .pe-slug-hint-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        padding: 0;
        border: none;
        background: none;
        font-size: 12px;
        color: var(--cms-text-dim);
        cursor: pointer;
        text-decoration: underline dotted;
        text-underline-offset: 3px;
    }

    .pe-slug-hint-btn:hover {
        color: var(--cms-accent);
    }

    .pe-slug-example {
        margin-top: 12px;
        padding: 12px 14px;
        background: var(--cms-bg);
        border: 1px solid var(--cms-border);
        border-radius: var(--radius-sm);
    }

    .pe-slug-example strong {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
        font-size: 13px;
    }

    .pe-slug-example p {
        margin: 0;
        font-size: 13px;
        color: var(--cms-text-muted);
    }

    .pe-lang-rows {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .pe-lang-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pe-lang-status {
        font-size: 10px;
        padding: 1px 6px;
    }

    .pe-lang-status-none {
        font-size: 11px;
        color: var(--cms-text-dim);
    }

    .pe-lang-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .03em;
        border: 1px solid transparent;
        cursor: pointer;
        font-family: inherit;
        text-decoration: none;
        transition: opacity var(--transition);
    }

    .pe-lang-badge:hover {
        opacity: 0.8;
    }

    .pe-lang-badge-yes {
        background: color-mix(in srgb, var(--cms-success) 18%, transparent);
        color: var(--cms-success);
        border-color: color-mix(in srgb, var(--cms-success) 40%, transparent);
    }

    .pe-lang-badge-no {
        background: color-mix(in srgb, var(--cms-danger) 12%, transparent);
        color: var(--cms-danger);
        border-color: color-mix(in srgb, var(--cms-danger) 35%, transparent);
        border-style: dashed;
    }

    .pe-lang-badge-no:disabled {
        opacity: 0.6;
        cursor: default;
    }

    .pe-lang-badge-plus {
        font-size: 9px;
        margin-right: 2px;
    }

    .pe-lang-badge:focus-visible {
        outline: 2px solid var(--cms-accent);
        outline-offset: 1px;
    }

    /* Marks a language that is authorable but not live on the public site. */
    .pe-lang-unpublished {
        font-size: 11px;
        color: var(--cms-warning);
        cursor: help;
    }

    .pe-lang-status-select {
        font-size: 11px;
        padding: 1px 4px;
        border-radius: 4px;
        border: 1px solid var(--cms-border);
        background: var(--cms-bg);
        color: var(--cms-text);
        cursor: pointer;
    }

    .pe-lang-delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        padding: 0;
        border: none;
        background: none;
        color: var(--cms-text-dim);
        cursor: pointer;
        border-radius: 4px;
        font-size: 12px;
        transition: color var(--transition), background var(--transition);
    }

    .pe-lang-delete-btn:hover {
        color: var(--cms-danger);
        background: color-mix(in srgb, var(--cms-danger) 12%, transparent);
    }

    /* Holds the view toggle (List/Tree) and the layout toggle (Grouped/Individual)
       side by side — two independent axes, kept visually distinct from each other
       (a gap, not a shared box) so they don't read as one four-way choice. */
    .pe-toggle-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 14px;
    }

    .pe-view-toggle {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        background: var(--cms-bg);
        border: 1px solid var(--cms-border);
        border-radius: var(--radius-sm);
    }

    .pe-view-toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border: none;
        border-radius: 5px;
        background: none;
        color: var(--cms-text-muted);
        font-size: 13px;
        cursor: pointer;
        transition: background var(--transition), color var(--transition);
    }

    /* A background-color swap alone (--cms-bg on the strip → --cms-card on the
       active button) is a strong cue in dark mode, where the two are far apart in
       lightness — but in light mode --cms-card is plain white sitting on a barely
       lighter-than-white strip, so the same swap was nearly invisible. Accent-
       colored, bolder text and a matching bottom bar are cues that read the same in
       both themes, independent of how close the two background shades happen to be. */
    .pe-view-toggle-btn.active {
        background: var(--cms-card);
        color: var(--cms-accent);
        font-weight: 600;
        box-shadow: inset 0 -2px 0 var(--cms-accent);
    }

    /* Stacked per-language cells (Title/Slug/Categories/Full Slug in the Grouped
       view) — one row per language, aligned the same way in every one of those
       columns so the Nth row always means the same language across the whole grid
       row. */
    .pe-stack {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .pe-stack-row {
        min-height: 20px;
        display: flex;
        align-items: center;
        line-height: 1.3;
    }

    .pe-stack-title {
        font-weight: 600;
        cursor: pointer;
    }

    .pe-stack-title:hover {
        color: var(--cms-accent);
    }

    .pe-stack-mono {
        font-size: 12px;
        font-family: ui-monospace, Consolas, monospace;
        color: var(--cms-text-muted);
    }

    .pe-stack-accent {
        color: var(--cms-accent);
    }

    .pe-stack-muted {
        font-size: 12.5px;
        color: var(--cms-text-muted);
    }

    .pe-tree-lang-badge {
        font-size: 10px;
        padding: 1px 6px;
        flex-shrink: 0;
    }

    /* ── Filters ──────────────────────────────────────────────────────────── */
    .pe-filter-btn-active {
        background: var(--cms-accent-light) !important;
        color: var(--cms-accent) !important;
        border-color: var(--cms-accent) !important;
    }

    .pe-filter-count {
        display: inline-grid;
        place-items: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 9px;
        background: var(--cms-accent);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
    }

