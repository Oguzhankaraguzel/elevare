    protected override async Task OnInitializedAsync()
    {
        try
        {
            (await Sender.Send(new GetLanguagesQuery())).Match(
                success => _languages = [.. success.Items],
                _ => { });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

        await LoadTemplatesAsync();

        try
        {
            (await Sender.Send(new GetTagsQuery())).Match(
                tags => _tagCandidates = tags,
                _ => { });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

        try
        {
            (await Sender.Send(new GetSiteCodeSnippetSummariesQuery())).Match(
                codes => _siteCodeSummaries = codes,
                _ => { });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

        try
        {
            (await Sender.Send(new GetSiteSettingsQuery(SiteSettingGroup.Identity))).Match(
                settings =>
                {
                    // Feeds the Navbar block's brand slot (see setSiteInfo in
                    // grapes-editor.js) — a logo uploaded in Site Settings has nowhere
                    // else to land on the public site, since the layout deliberately
                    // carries no site-wide header of its own.
                    _logoUrl = settings.FirstOrDefault(s => s.Key == "Appearance.LogoUrl")?.Value;
                    _siteName = settings.FirstOrDefault(s => s.Key == "General.SiteName")?.Value;
                },
                _ => { });

            // The published <title> is not just the page title: the public layout
            // renders "{page title} - {suffix}", where the suffix is the SEO settings'
            // title suffix or, when that is blank, the site name. The SEO analyser
            // needs the same suffix to judge the real title length and to explain
            // where the extra text comes from (see the title check in elevare-seo.js).
            (await Sender.Send(new GetSiteSettingsQuery(SiteSettingGroup.Seo))).Match(
                seo =>
                {
                    _metaTitleSuffix = seo.FirstOrDefault(s => s.Key == "Seo.DefaultMetaTitleSuffix")?.Value;
                    _defaultMetaDescription = seo.FirstOrDefault(s => s.Key == "Seo.DefaultMetaDescription")?.Value;
                    _defaultShareImage = seo.FirstOrDefault(s => s.Key == "Seo.DefaultOgImageUrl")?.Value;
                },
                _ => { });

            // Identity, not Advanced: the key still says "Advanced." but the setting
            // lives on the Site Identity screen, and asking the Advanced group always
            // came back without it — the editor never knew the page's address, so
            // "Otomatik doldur" could not fill og:url and the address checks never ran.
            (await Sender.Send(new GetSiteSettingsQuery(SiteSettingGroup.Identity))).Match(
                identity => _publicSiteBaseUrl = identity.FirstOrDefault(s => s.Key == "Advanced.PublicSiteBaseUrl")?.Value,
                _ => { });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

        // The logo is almost always uploaded through the Media Library, which already
        // asks for alt text at upload time — reusing it beats guessing a description
        // from the site name, and only falls through to the site name when the logo
        // was set some other way (a raw URL, no Media Library record behind it).
        if (!string.IsNullOrWhiteSpace(_logoUrl))
        {
            try
            {
                (await Sender.Send(new GetMediaFileAltTextQuery(_logoUrl))).Match(
                    alt => _logoAlt = alt,
                    _ => { });
            }
            catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
        }

        // Blocks that render a business's real-world details (map, opening hours)
        // start from what Site Settings already knows instead of the placeholder
        // address the block template would otherwise ship with — see setSiteInfo
        // in grapes-editor.js.
        try
        {
            (await Sender.Send(new GetSiteSettingsQuery(SiteSettingGroup.ContactSocial))).Match(
                settings =>
                {
                    _mapEmbedUrl = settings.FirstOrDefault(s => s.Key == "Contact.MapEmbedUrl")?.Value;
                    _workingHours = settings.FirstOrDefault(s => s.Key == "Contact.WorkingHours")?.Value;
                    _contact = SiteContactInfo.From(settings);
                    _xProfileUrl = settings.FirstOrDefault(s => s.Key == "Social.XUrl")?.Value;
                },
                _ => { });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        _editorReady = false;
        _editorInitStarted = false;
        try
        {
            (await Sender.Send(new GetPageByIdQuery(Id))).Match(
                page => Apply(page),
                _ => _notFound = true);
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name);
            _notFound = true;
        }

        if (!_notFound)
        {
            try
            {
                (await Sender.Send(new GetPageTranslationsQuery(Id))).Match(
                    resp => _translations = resp.Translations,
                    _ => _translations = []);
            }
            catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

            try
            {
                (await Sender.Send(new GetPageParentCandidatesQuery(_currentLanguageId, Id))).Match(
                    candidates => _parentCandidates = candidates,
                    _ => _parentCandidates = []);
            }
            catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

            try
            {
                (await Sender.Send(new GetPageDirectoryQuery(_currentLanguageId))).Match(
                    pages => _pageDirectory = pages,
                    _ => _pageDirectory = []);
            }
            catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

            _parentSearch = ParentLabel(_parentCandidates.FirstOrDefault(c => c.Id == _parentPageId));
        }

        // Baseline for the unsaved-changes guard: everything loaded above IS what
        // the server holds, so the editor must not open already looking dirty.
        MarkSaved();

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Apply(PageEditorResponse page)
    {
        _title = page.Title;
        _slug = page.Slug;
        _fullSlug = page.FullSlug;
        // When a save is awaiting approval, the dropdown must show what was asked
        // for (Published), not what is still actually live (Draft) — otherwise a
        // second editor who saves without touching this field silently resubmits
        // the live status and erases PendingStatus, and the page never goes live
        // even after the chain is approved.
        _status = page.PendingStatus ?? page.Status;
        _pendingStatus = page.PendingStatus;
        _originalSlug = page.Slug;
        // Unlike _status, this tracks the page's actual live status — it gates the
        // slug-change/redirect confirmation below, which only matters once a page
        // is truly Published, not merely pending it.
        _originalStatus = page.Status;
        _gjsHtml = page.GjsHtml;
        _gjsCss = page.GjsCss;
        _gjsData = page.GjsData;
        _fingerprint = page.Fingerprint;
        _currentLanguageId = page.LanguageId;
        _languageName = _languages.FirstOrDefault(l => l.Id == page.LanguageId)?.NameInNative ?? "";
        _parentPageId = page.ParentPageId;
        _selectedTagIds = [.. page.TagIds];
        _excludedSiteCodeIds = [.. page.ExcludedSiteCodeSnippetIds];

        _isCanonical = page.Seo.IsCanonical;
        _canonicalUrl = page.Seo.CanonicalUrl;
        _metaDescription = page.Seo.MetaDescription;
        _metaAuthor = page.Seo.MetaAuthor;
        _noIndex = page.Seo.NoIndex;
        _noFollow = page.Seo.NoFollow;
        _kind = page.Kind;
        _audit = page.Audit;
        _focusKeyword = page.Seo.FocusKeyword;
        _structuredData = page.Seo.StructuredData;
        _social = new SocialShareModel
        {
            OgTitle = page.Seo.OgTitle,
            OgDescription = page.Seo.OgDescription,
            OgType = page.Seo.OgType.HasValue() ? page.Seo.OgType : "website",
            OgImage = page.Seo.OgImage,
            OgUrl = page.Seo.OgUrl,
            TwitterCard = page.Seo.TwitterCard,
            TwitterSite = page.Seo.TwitterSite,
            Meta = page.Seo.Social
        };
        // Seed with the last persisted score so the badge isn't empty on open —
        // elevare-seo.js's initial analysis will overwrite it moments later with a
        // fresh score against the (possibly just-loaded) current content.
        _seoScore = page.SeoScore;
    }

