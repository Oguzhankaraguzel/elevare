@page "/pages/edit/{Id:int}"
@layout CMSLayout
@implements IAsyncDisposable
@using SharedKernel.Social
@using Application.Features.Queries.Pages.GetListingPreview
@inject IJSRuntime JS

@* Editing a page holds a lot of unsaved state (canvas content, SEO fields, parent,
   tags) that the server knows nothing about until Save. Without this, ANY way out of
   the editor — a sidebar link, the browser Back button, a reload — discarded all of it
   silently. ConfirmExternalNavigation covers the browser-level exits; the callback
   covers in-app navigation, where we can say what is actually at stake. *@
<NavigationLock ConfirmExternalNavigation="IsDirty" OnBeforeInternalNavigation="ConfirmLeavingUnsaved" />

<PageTitle>@(_title.HasValue() ? _title : L["PageEditor_NewPageTitle"])</PageTitle>

@if (_loading)
{
    <div style="padding:40px;text-align:center;color:var(--cms-text-muted)">
        <i class="bi bi-arrow-clockwise spin" style="font-size:24px"></i>
    </div>
}
else if (_notFound)
{
    <div style="padding:40px;text-align:center;color:var(--cms-text-muted)">@L["PageEditor_LoadError"]</div>
}
else
{
    <div class="pe-toolbar">
        <div class="pe-toolbar-fields">
            <a href="/pages" class="btn-cms btn-ghost btn-sm-cms" title="@L["PageEditor_BackToList"]">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div class="pe-field">
                <label>@L["PageEditor_FieldTitle"]</label>
                @* @bind:after keeps the SEO analyser's title check live as it is typed;
                   updateSeoMeta debounces on the JS side, so this is not one analysis
                   pass per keystroke. *@
                <input id="pe-page-title-input" @bind="_title" @bind:event="oninput" @bind:after="PushSeoMetaToJs" class="cms-input" />
            </div>
            <div class="pe-field">
                <label>@L["PageEditor_FieldSlug"]</label>
                <input @bind="_slug" class="cms-input" />
            </div>
            <div class="pe-field pe-field-sm">
                <label>@L["PageEditor_FieldStatus"]</label>
                <select @bind="_status" class="cms-input">
                    <option value="@PageStatus.Draft">@L["Pages_StatusDraft"]</option>
                    <option value="@PageStatus.Published">@L["Pages_StatusPublished"]</option>
                    <option value="@PageStatus.Archived">@L["Pages_StatusArchived"]</option>
                </select>
                @if (_pendingStatus.HasValue)
                {
                    <span class="badge-cms badge-warning" style="margin-top:4px;display:inline-block"
                          title="@L["PageEditor_PendingStatusHint"]">
                        <i class="bi bi-hourglass-split"></i> @L["PageEditor_PendingStatusBadge"]
                    </span>
                }
            </div>
            <div class="pe-field pe-field-sm">
                <label>@L["PageEditor_FieldLanguage"]</label>
                <input value="@_languageName" class="cms-input" disabled />
            </div>
            <div class="pe-field pe-field-sm">
                <label title="@L["PageKind_Hint"]">
                    @L["PageEditor_FieldKind"] <i class="bi bi-info-circle" style="font-size:11px;opacity:.6"></i>
                </label>
                <select @bind="_kind" class="cms-input">
                    @foreach (PageKind kind in AllPageKinds)
                    {
                        <option value="@kind">@PageKindLabel(kind)</option>
                    }
                </select>
            </div>
            <div class="pe-field elevare-parent-picker">
                <label>@L["PageEditor_FieldParent"]</label>
                <input class="cms-input" value="@_parentSearch" placeholder="@L["PageEditor_ParentNone"]"
                       @oninput="OnParentSearchInput" @onfocus="() => _parentDropdownOpen = true" @onblur="OnParentInputBlur" />
                @if (_parentDropdownOpen)
                {
                    @* Buttons, and BOTH mousedown and click are wired: mousedown (with
                       preventDefault) is what lands before the input's blur closes the
                       list, while click is the only event a keyboard Enter/Space
                       produces. SelectParent is idempotent, so a mouse click firing
                       both is harmless. *@
                    <div class="elevare-parent-dropdown" role="listbox">
                        <button type="button" role="option" aria-selected="@(_parentPageId is null)"
                                class="elevare-parent-option @(_parentPageId is null ? "elevare-parent-option-active" : "")"
                                @onmousedown:preventDefault="true" @onmousedown="() => SelectParent(null)"
                                @onclick="() => SelectParent(null)">
                            @L["PageEditor_ParentNone"]
                        </button>
                        @foreach (PageParentCandidateResponse c in FilteredParentCandidates)
                        {
                            <button type="button" role="option" aria-selected="@(_parentPageId == c.Id)"
                                    class="elevare-parent-option @(_parentPageId == c.Id ? "elevare-parent-option-active" : "")"
                                    @onmousedown:preventDefault="true" @onmousedown="() => SelectParent(c)"
                                    @onclick="() => SelectParent(c)">
                                <span class="elevare-parent-path">@PagePath(c)</span>
                                <span class="elevare-parent-title">@c.Title</span>
                            </button>
                        }
                        @if (FilteredParentCandidates.Count == 0)
                        {
                            <div class="elevare-parent-option elevare-parent-option-empty">@L["PageEditor_ParentNoMatch"]</div>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="pe-toolbar-actions">
            @* One door to everything that describes the page rather than fills it:
               SEO, social cards, structured data, tags, language versions, site
               codes. They were six toolbar buttons — a row an author scanned every
               time to find the one they meant — plus a Guide and an Import that
               belong to a different kind of task. *@
            <button type="button" class="btn-cms btn-ghost btn-sm-cms" @onclick="() => _settingsOpen = true" title="@L["PageEditor_SettingsPanelTitle"]">
                <i class="bi bi-sliders"></i> @L["PageEditor_SettingsPanelTitle"]
                @if (_excludedSiteCodeIds.Count > 0)
                {
                    <span class="pe-toolbar-count" title="@L["PageEditor_SiteCodesPanelTitle"]">@_excludedSiteCodeIds.Count</span>
                }
            </button>
            <button type="button" class="btn-cms btn-ghost btn-sm-cms btn-icon" @onclick="() => _helpGuideOpen = true" title="@L["PageEditor_HelpGuideBtn"]" aria-label="@L["PageEditor_HelpGuideBtn"]">
                <i class="bi bi-question-circle"></i>
            </button>
            @if (UserContext.CanAuthorCustomCode)
            {
                <button type="button" class="btn-cms btn-ghost btn-sm-cms btn-icon" @onclick="() => _importCodeOpen = true" title="@L["PageEditor_ImportCodeBtn"]" aria-label="@L["PageEditor_ImportCodeBtn"]">
                    <i class="bi bi-code-slash"></i>
                </button>
            }
            <button class="btn-cms btn-ghost btn-sm-cms" @onclick="Preview" title="@L["PageEditor_PreviewBtn"]">
                <i class="bi bi-eye"></i> @L["PageEditor_PreviewBtn"]
            </button>
            @if (IsDirty)
            {
                <span class="pe-unsaved-badge" title="@L["PageEditor_UnsavedWarning"]">
                    <i class="bi bi-dot"></i> @L["PageEditor_UnsavedBadge"]
                </span>
            }
            <button class="btn-cms btn-primary-cms pe-save" @onclick="SaveAll" disabled="@_saving">
                @if (_saving)
                {
                    <i class="bi bi-arrow-clockwise spin"></i>
                }
                else
                {
                    <i class="bi bi-floppy"></i>
                }
                @L["PageEditor_Save"]
            </button>
        </div>
    </div>

    <StaleTemplateNotice @ref="_staleNotice" Scope="StaleTemplateScope.Page" />

    <div class="pe-editor-wrap">
        @if (!_editorReady)
        {
            <div class="pe-editor-loading">
                <i class="bi bi-arrow-clockwise spin"></i> @L["PageEditor_EditorLoading"]
            </div>
        }
        @* The editor's side column — see SIDE in grapes-editor.js, which fills
           it: the selected element's content and style, layers, blocks. *@
        <div id="gjs"></div>
        <aside id="pe-side-right" class="pe-side" aria-label="@L["PageEditor_SideRightLabel"]"></aside>

        @* Drag-and-drop image upload. grapes-editor.js catches the drop inside the
           canvas iframe and hands the File to THIS input; Blazor's InputFile then
           streams it, which is what makes arbitrarily large images work — passing
           bytes through JS interop would hit the message-size ceiling instead.
           Hidden rather than absent: it must exist in the DOM for JS to find it. *@
        <InputFile id="elevare-drop-input" OnChange="HandleDroppedImage" accept="image/*"
                   style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none" tabindex="-1" aria-hidden="true" />

        @if (_uploadingDroppedImage)
        {
            <div class="pe-drop-uploading">
                <i class="bi bi-arrow-clockwise spin"></i> @L["PageEditor_DropUploading"]
            </div>
        }

        @* A movable, resizable window rather than a slide-in panel: the structured-
           data builder needs the width, and because a window does not black out the
           page behind it, the Media Library window can be opened next to it — a
           picture URL no longer means closing this first. *@
        <CmsModal Title="@L["PageEditor_SettingsPanelTitle"]" IsVisible="_settingsOpen"
                  OnClose="() => _settingsOpen = false" Size="xl">
            <Body>
                <div class="elevare-settings-tabs" role="tablist">
                    @foreach (PageSettingsTab tab in Enum.GetValues<PageSettingsTab>())
                    {
                        <button type="button" role="tab" class="elevare-settings-tab @(_settingsTab == tab ? "is-active" : "")"
                                aria-selected="@(_settingsTab == tab)" @onclick="() => _settingsTab = tab">
                            <i class="bi @SettingsTabIcon(tab)"></i> @SettingsTabLabel(tab)
                            @if (tab == PageSettingsTab.SiteCodes && _excludedSiteCodeIds.Count > 0)
                            {
                                <span class="pe-toolbar-count">@_excludedSiteCodeIds.Count</span>
                            }
                        </button>
                    }
                </div>

                <div class="elevare-seo-panel-body">
                    @switch (_settingsTab)
                    {
                        case PageSettingsTab.Seo:
                            <div class="elevare-settings-body">
                            <div class="elevare-seo-score-box">
                                <div class="elevare-seo-score-box-top">
                                    <span class="elevare-seo-score-box-label">@L["PageEditor_SeoScoreLabel"]</span>
                                    @if (_seoScore.HasValue)
                                    {
                                        <span class="elevare-seo-score-box-value" style="color:@ScoreColor(_seoScore.Value)">@_seoScore</span>
                                    }
                                    else
                                    {
                                        <span class="elevare-seo-score-box-value elevare-seo-score-empty">@L["PageEditor_SeoScoreNotYet"]</span>
                                    }
                                </div>
                                <button type="button" class="btn-cms btn-ghost btn-sm-cms" @onclick="ReanalyzeSeo">
                                    <i class="bi bi-arrow-clockwise"></i> @L["PageEditor_SeoReanalyze"]
                                </button>
                                <p class="elevare-seo-score-hint">@L["PageEditor_SeoScoreHint"]</p>
                            </div>

                            <h4>@L["PageEditor_SeoSectionGeneral"]</h4>
                            <div class="pe-field">
                                <label>@L["PageEditor_SeoFocusKeyword"]</label>
                                <input @bind="_focusKeyword" @bind:event="oninput" @bind:after="PushSeoMetaToJs" class="cms-input" placeholder="@L["PageEditor_SeoFocusKeywordPlaceholder"]" />
                            </div>
                            <div class="pe-field">
                                <label>@L["PageEditor_SeoMetaDescription"]</label>
                                <textarea @bind="_metaDescription" @bind:event="oninput" @bind:after="PushSeoMetaToJs" class="cms-input" rows="3" placeholder="@L["PageEditor_SeoMetaDescriptionPlaceholder"]"></textarea>
                                <span class="elevare-seo-charcount">@(_metaDescription?.Length ?? 0) @L["PageEditor_SeoCharacters"]</span>
                            </div>
                            <div class="pe-field">
                                <label>@L["PageEditor_SeoMetaAuthor"]</label>
                                <input @bind="_metaAuthor" class="cms-input" />
                            </div>

                            <h4>@L["PageEditor_SeoRobotsTitle"]</h4>
                            <p class="pe-field-hint">@L["PageEditor_SeoRobotsIntro"]</p>
                            <div class="pe-field">
                                <label class="pe-check">
                                    <input type="checkbox" @bind="_noIndex" />
                                    <span>@L["PageEditor_SeoNoIndex"]</span>
                                </label>
                                <span class="pe-field-hint">@L["PageEditor_SeoNoIndexHint"]</span>
                            </div>
                            <div class="pe-field">
                                <label class="pe-check">
                                    <input type="checkbox" @bind="_noFollow" />
                                    <span>@L["PageEditor_SeoNoFollow"]</span>
                                </label>
                                <span class="pe-field-hint">@L["PageEditor_SeoNoFollowHint"]</span>
                            </div>
                            @if (_noIndex)
                            {
                                <div class="pe-robots-warning">
                                    <i class="bi bi-exclamation-triangle-fill"></i> @L["PageEditor_SeoNoIndexWarning"]
                                </div>
                            }

                            @* Open Graph and X used to live here; they have their own panel now
                               (Sosyal Paylaşım), with the type-specific properties and the
                               card types this one never had room for. *@
                            <div class="pe-field">
                                <button type="button" class="btn-cms btn-ghost w-100"
                                        @onclick="() => _settingsTab = PageSettingsTab.Social">
                                    <i class="bi bi-share"></i> @L["Social_OpenFromSeo"]
                                </button>
                            </div>

                            <h4>@L["PageEditor_SeoSectionAdvanced"]</h4>
                            <div class="pe-field pe-field-checkbox">
                                <label>
                                    <input type="checkbox" @bind="_isCanonical" />
                                    @L["PageEditor_SeoIsCanonical"]
                                </label>
                            </div>
                            @if (!_isCanonical)
                            {
                                <div class="pe-field">
                                    <label>@L["PageEditor_SeoCanonicalUrl"]</label>
                                    <input @bind="_canonicalUrl" class="cms-input" placeholder="https://..." />
                                </div>
                            }
                            @* The raw textarea is gone: structured data is built in its own
                               panel now, which keeps the JSON valid by construction. This
                               just reports the state and opens that panel. *@
                            <div class="pe-field">
                                <label>@L["PageEditor_SeoStructuredData"]</label>
                                <button type="button" class="btn-cms btn-ghost w-100"
                                        @onclick="() => _settingsTab = PageSettingsTab.StructuredData">
                                    <i class="bi bi-diagram-3"></i>
                                    @(string.IsNullOrWhiteSpace(_structuredData)
                                        ? L["PageEditor_StructuredDataOpenEmpty"]
                                        : L["PageEditor_StructuredDataOpenFilled"])
                                </button>
                            </div>

                            @* Who touched this page. The columns have always been there;
                               showing them turns "who published this?" from a database
                               question into something anyone can answer. *@
                            @if (_audit is { } audit)
                            {
                                <h4>@L["PageEditor_AuditTitle"]</h4>
                                <dl class="pe-audit">
                                    <dt>@L["PageEditor_AuditCreated"]</dt>
                                    <dd>@FormatAudit(audit.CreatedBy, audit.CreatedAt)</dd>
                                    <dt>@L["PageEditor_AuditUpdated"]</dt>
                                    <dd>@FormatAudit(audit.UpdatedBy, audit.UpdatedAt)</dd>
                                    @* What listings, structured data and share tags date the page by. *@
                                    <dt>@L["PageEditor_AuditPublished"]</dt>
                                    <dd title="@L["PageEditor_AuditPublishedHint"]">@(audit.PublishedAt is { } published ? published.ToString("dd.MM.yyyy", System.Globalization.CultureInfo.InvariantCulture) : "—")</dd>
                                </dl>
                            }

                            </div>
                            break;
                        case PageSettingsTab.Social:
                            <div class="elevare-settings-body">
                            <SocialSharePanel Model="_social" FallbackTitle="@_title" FallbackDescription="@_metaDescription"
                                              SiteName="@(_siteName ?? "")" Suggestions="SocialSuggestions" OnChanged="PushSeoMetaToJs" Embedded="true" />
                            </div>
                            break;
                        case PageSettingsTab.StructuredData:
                            <div class="elevare-settings-body">
                            @* The @ on Value matters: without it Razor passes the literal text
                               "_structuredData" to a string parameter instead of the field's value. *@
                            <StructuredDataPanel PageId="Id" Value="@_structuredData" ValueChanged="@OnStructuredDataChanged" />
                            </div>
                            break;
                        case PageSettingsTab.Tags:
                            <div class="elevare-settings-body">
                            <p class="elevare-lang-hint">@L["PageEditor_TagsPanelHint"]</p>

                            @if (SelectedTags.Count > 0)
                            {
                                <div class="elevare-tag-chips">
                                    @foreach (TagResponse t in SelectedTags)
                                    {
                                        <span class="elevare-tag-chip">
                                            @t.Name
                                            <button type="button" @onclick="() => RemoveTag(t.Id)"><i class="bi bi-x"></i></button>
                                        </span>
                                    }
                                </div>
                            }

                            <div class="elevare-parent-picker">
                                <input class="cms-input" value="@_tagSearch" placeholder="@L["PageEditor_TagsSearchPlaceholder"]"
                                       @oninput="OnTagSearchInput" @onfocus="() => _tagDropdownOpen = true" @onblur="OnTagInputBlur" />
                                @if (_tagDropdownOpen)
                                {
                                    @* Same mousedown + click pairing as the parent picker — see the
                                       comment there. Both handlers are safe to run twice. *@
                                    <div class="elevare-parent-dropdown" role="listbox">
                                        @foreach (TagResponse c in FilteredTagCandidates)
                                        {
                                            <button type="button" role="option" aria-selected="false" class="elevare-parent-option"
                                                    @onmousedown:preventDefault="true" @onmousedown="() => SelectTag(c)"
                                                    @onclick="() => SelectTag(c)">
                                                @c.Name
                                            </button>
                                        }
                                        @if (FilteredTagCandidates.Count == 0 && _tagSearch.HasValue())
                                        {
                                            <button type="button" class="elevare-parent-option"
                                                    @onmousedown:preventDefault="true" @onmousedown="CreateAndSelectTag"
                                                    @onclick="CreateAndSelectTag">
                                                @if (_creatingTag)
                                                {
                                                    <i class="bi bi-arrow-clockwise spin"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-plus-lg"></i>
                                                }
                                                @string.Format(L["PageEditor_TagsCreateBtn"], _tagSearch)
                                            </button>
                                        }
                                        @if (FilteredTagCandidates.Count == 0 && !_tagSearch.HasValue())
                                        {
                                            <div class="elevare-parent-option elevare-parent-option-empty">@L["PageEditor_TagsNoMore"]</div>
                                        }
                                    </div>
                                }
                            </div>

                            </div>
                            break;
                        case PageSettingsTab.Languages:
                            <div class="elevare-settings-body">
                            <p class="elevare-lang-hint">@L["PageEditor_LangPanelHint"]</p>

                            @if (_translations.Count > 0)
                            {
                                <h4>@L["PageEditor_LangExistingTitle"]</h4>
                                <div class="elevare-lang-list">
                                    @foreach (PageTranslationItem t in _translations)
                                    {
                                        <a href="@($"/pages/edit/{t.PageId}")" class="elevare-lang-row">
                                            <span class="elevare-lang-code">@t.TwoLetterCode.ToUpperInvariant()</span>
                                            <span class="elevare-lang-name">@t.LanguageName</span>
                                            <span class="elevare-lang-status elevare-lang-status-@t.Status.ToString().ToLowerInvariant()">@StatusLabel(t.Status)</span>
                                        </a>
                                    }
                                </div>
                            }

                            @{
                                List<LanguageResponse> missing = [.. _languages
                                    .Where(l => l.Id != _currentLanguageId && _translations.All(t => t.LanguageId != l.Id))];
                            }
                            @if (missing.Count > 0)
                            {
                                <h4>@L["PageEditor_LangCreateTitle"]</h4>
                                <div class="elevare-lang-list">
                                    @foreach (LanguageResponse lang in missing)
                                    {
                                        <button type="button" class="elevare-lang-create-btn" disabled="@(_creatingLanguageId is not null)" @onclick="() => CreateTranslation(lang.Id)">
                                            @if (_creatingLanguageId == lang.Id)
                                            {
                                                <i class="bi bi-arrow-clockwise spin"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-plus-lg"></i>
                                            }
                                            @string.Format(L["PageEditor_LangCreateBtn"], lang.NameInNative)
                                        </button>
                                    }
                                </div>
                            }

                            </div>
                            break;
                        case PageSettingsTab.SiteCodes:
                            <div class="elevare-settings-body">
                                <div class="pe-sitecodes-warning">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <span>@L["PageEditor_SiteCodesWarning"]</span>
                                </div>
                                @if (_siteCodeSummaries.Count == 0)
                                {
                                    <p style="color:var(--cms-text-muted);margin:12px 0 0">@L["PageEditor_SiteCodesNone"]</p>
                                }
                                else
                                {
                                    @foreach (SiteCodePlacement placement in Enum.GetValues<SiteCodePlacement>())
                                    {
                                        List<SiteCodeSnippetSummaryResponse> inPlacement = [.. _siteCodeSummaries.Where(s => s.Placement == placement)];
                                        <div class="pe-sitecodes-group">
                                            <h4>@L[$"SiteCode_Placement_{placement}"]</h4>
                                            @if (inPlacement.Count == 0)
                                            {
                                                <p class="pe-sitecodes-empty">@L["PageEditor_SiteCodesPlacementEmpty"]</p>
                                            }
                                            else
                                            {
                                                @foreach (SiteCodeSnippetSummaryResponse s in inPlacement)
                                                {
                                                    bool excluded = _excludedSiteCodeIds.Contains(s.Id);
                                                    <label class="pe-sitecodes-row @(s.IsEnabled ? "" : "is-disabled") @(excluded ? "is-excluded" : "")">
                                                        <input type="checkbox" checked="@excluded" @onchange="e => ToggleSiteCodeExclusion(s.Id, e.Value is true)" />
                                                        <span class="pe-sitecodes-name">@s.Name</span>
                                                        <span class="pe-sitecodes-meta">
                                                            @L[$"SiteCode_Kind_{s.Kind}"]@(s.Preset != SiteCodePreset.Custom ? " · " + L[$"SiteCode_Preset_{s.Preset}"] : "")
                                                            @if (!s.IsEnabled)
                                                            {
                                                                <span class="pe-sitecodes-off">@L["PageEditor_SiteCodesDisabledBadge"]</span>
                                                            }
                                                        </span>
                                                        <span class="pe-sitecodes-action">@L["PageEditor_SiteCodesExcludeLabel"]</span>
                                                    </label>
                                                }
                                            }
                                        </div>
                                    }
                                }

                            <a href="/admin/site-code" target="_blank" rel="noopener" class="btn-cms btn-ghost" style="margin-top:14px">
                                <i class="bi bi-box-arrow-up-right"></i> @L["PageEditor_SiteCodesGoTo"]
                            </a>
                            </div>
                            break;
                    }
                </div>
            </Body>
        </CmsModal>
    </div>
}

@* ── Pop-up & Form actions help guide ────────────────────────────────────── *@
<CmsModal Title="@L["PageEditor_HelpGuideTitle"]" IsVisible="_helpGuideOpen" OnClose="() => _helpGuideOpen = false" Size="md">
    <Body>
        <a href="/admin/guide" target="_blank" class="elevare-guide-fullpage-link">
            <i class="bi bi-box-arrow-up-right"></i> @L["PageEditor_HelpGuideOpenFullPage"]
        </a>
        <GuideContent />
    </Body>
    <Footer>
        <button class="btn-cms btn-primary-cms" @onclick="() => _helpGuideOpen = false">@L["Common_Close"]</button>
    </Footer>
</CmsModal>



@* ── Raw HTML/CSS import (Developer/Admin/SuperAdmin only, same gate as custom code) ── *@
<CmsModal Title="@L["PageEditor_ImportCodeTitle"]" IsVisible="_importCodeOpen" OnClose="() => _importCodeOpen = false" Size="lg">
    <Body>
        <p style="color:var(--cms-text-muted);font-size:13px">@L["PageEditor_ImportCodeHint"]</p>
        <div class="pe-field">
            <label>@L["PageEditor_ImportCodeHtmlLabel"]</label>
            <textarea @bind="_importHtml" @bind:event="oninput" class="cms-input" rows="8" style="font-family:monospace;font-size:12.5px" placeholder="&lt;div&gt;...&lt;/div&gt;"></textarea>
        </div>
        <div class="pe-field" style="margin-top:10px">
            <label>@L["PageEditor_ImportCodeCssLabel"]</label>
            <textarea @bind="_importCss" @bind:event="oninput" class="cms-input" rows="6" style="font-family:monospace;font-size:12.5px" placeholder=".my-class { color: red; }"></textarea>
        </div>
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="() => _importCodeOpen = false">@L["Pages_CancelBtn"]</button>
        @* Deliberately NOT the same label as the menu item that opens this modal:
           two different controls reading "Kod İçe Aktar" is ambiguous by voice and
           indistinguishable to a screen reader announcing them in isolation. *@
        <button class="btn-cms btn-primary-cms" @onclick="ImportCode" disabled="@string.IsNullOrWhiteSpace(_importHtml)">
            <i class="bi bi-box-arrow-in-down"></i> @L["PageEditor_ImportCodeSubmit"]
        </button>
    </Footer>
</CmsModal>

@* ── Edit conflict: the page changed since this editor opened it ─────────── *@
<CmsModal Title="@L["PageEditor_ConflictTitle"]" IsVisible="_showEditConflict" OnClose="() => _showEditConflict = false" Size="md">
    <Body>
        <p style="color:var(--cms-text)">@L["PageEditor_ConflictBody"]</p>
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="ReloadAfterConflict" disabled="@_saving">@L["PageEditor_ConflictReload"]</button>
        <button class="btn-cms btn-danger-cms" @onclick="OverwriteAfterConflict" disabled="@_saving">@L["PageEditor_ConflictOverwrite"]</button>
    </Footer>
</CmsModal>

@* ── Slug-change confirmation (only for an already-Published page) ──────── *@
<CmsModal Title="@L["PageEditor_SlugChangeConfirmTitle"]" IsVisible="_showSlugChangeConfirm" OnClose="CancelSlugChangeConfirm" Size="sm">
    <Body>
        <p style="color:var(--cms-text)">@L["PageEditor_SlugChangeConfirmBody"]</p>
    </Body>
    <Footer>
        <button class="btn-cms btn-ghost" @onclick="CancelSlugChangeConfirm">@L["Pages_CancelBtn"]</button>
        <button class="btn-cms btn-primary-cms" @onclick="ConfirmSlugChangeAndSave" disabled="@_saving">
            @if (_saving)
            {
                <i class="bi bi-arrow-clockwise spin"></i>
            }
            else
            {
                <i class="bi bi-check2"></i>
            }
            @L["Common_Confirm"]
        </button>
    </Footer>
</CmsModal>

