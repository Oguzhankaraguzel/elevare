@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _notFound;
    private bool _editorReady;
    private bool _editorInitStarted;
    // One side panel for everything about the page (see the toolbar); which of
    // its tabs is showing is remembered while the editor is open.
    private bool _settingsOpen;
    private PageSettingsTab _settingsTab = PageSettingsTab.Seo;

    private enum PageSettingsTab { Seo, Social, StructuredData, Tags, Languages, SiteCodes }

    private string SettingsTabLabel(PageSettingsTab tab) => tab switch
    {
        PageSettingsTab.Seo => L["PageEditor_SeoPanelTitle"],
        PageSettingsTab.Social => L["Social_PanelTitle"],
        PageSettingsTab.StructuredData => L["PageEditor_StructuredDataPanelTitle"],
        PageSettingsTab.Tags => L["PageEditor_TagsPanelTitle"],
        PageSettingsTab.Languages => L["PageEditor_LangPanelTitle"],
        PageSettingsTab.SiteCodes => L["PageEditor_SiteCodesPanelTitle"],
        _ => tab.ToString()
    };

    private static string SettingsTabIcon(PageSettingsTab tab) => tab switch
    {
        PageSettingsTab.Seo => "bi-search",
        PageSettingsTab.Social => "bi-share",
        PageSettingsTab.StructuredData => "bi-diagram-3",
        PageSettingsTab.Tags => "bi-tags",
        PageSettingsTab.Languages => "bi-translate",
        PageSettingsTab.SiteCodes => "bi-code-square",
        _ => "bi-circle"
    };
    // Site codes switched off on this page (ids), and the catalogue the dialog
    // lists — names/placements only, see GetSiteCodeSnippetSummariesQuery.
    private HashSet<int> _excludedSiteCodeIds = [];
    private List<SiteCodeSnippetSummaryResponse> _siteCodeSummaries = [];

    private async Task ToggleSiteCodeExclusion(int id, bool excluded)
    {
        if (excluded) _excludedSiteCodeIds.Add(id); else _excludedSiteCodeIds.Remove(id);
        // The canvas drops (or gets back) the stylesheet right away; the page itself
        // only changes on Save.
        try { await JS.InvokeVoidAsync("grapesEditor.setExcludedSiteCodes", _excludedSiteCodeIds.ToArray()); }
        catch (JSException) { /* editor not up yet — init() reads the set itself */ }
    }
    private bool _helpGuideOpen;
    private bool _importCodeOpen;
    private string _importHtml = "";
    private string _importCss = "";
    private bool _showSlugChangeConfirm;
    // The page as this editor loaded it — sent with every save, see PageFingerprint.
    private string? _fingerprint;
    private bool _showEditConflict;
    private bool _overwriteNext;
    private bool _slugChangeConfirmed;
    private string _originalSlug = "";
    private PageStatus _originalStatus = PageStatus.Draft;

    private string _title = "";
    private string _slug = "";
    private string _languageName = "";
    private int _currentLanguageId;
    private PageStatus _status = PageStatus.Draft;
    private PageStatus? _pendingStatus;
    private List<PageTranslationItem> _translations = [];
    private int? _creatingLanguageId;
    private int? _parentPageId;
    private List<PageParentCandidateResponse> _parentCandidates = [];
    // Same shape as _parentCandidates but WITHOUT the self/descendant exclusion —
    // the Sayfa Listesi block's "Kaynak Sayfa" dropdown may legitimately point at
    // this page's own sub-categories.
    private List<PageDirectoryEntryResponse> _pageDirectory = [];
    private string _parentSearch = "";
    private bool _parentDropdownOpen;

    // The box shows the chosen page as "/path · Title"; while it still says exactly
    // that, the list is not a search yet and shows everything.
    private List<PageParentCandidateResponse> FilteredParentCandidates =>
        string.IsNullOrWhiteSpace(_parentSearch) || _parentSearch == ParentLabel(_parentCandidates.FirstOrDefault(c => c.Id == _parentPageId))
            ? _parentCandidates
            : [.. _parentCandidates.Where(c =>
                PagePath(c).Contains(_parentSearch, StringComparison.OrdinalIgnoreCase) ||
                c.Title.Contains(_parentSearch, StringComparison.OrdinalIgnoreCase))];

    // A page's public path: the home page's FullSlug is empty ("") or just the
    // language code, so it reads "/" or "/en" rather than a blank line.
    private static string PagePath(PageParentCandidateResponse c) => "/" + c.FullSlug;

    private static string ParentLabel(PageParentCandidateResponse? c)
    {
        if (c is null) return "";
        return string.IsNullOrWhiteSpace(c.Title) ? PagePath(c) : $"{PagePath(c)} · {c.Title}";
    }

    private void OnParentSearchInput(ChangeEventArgs e)
    {
        _parentSearch = e.Value?.ToString() ?? "";
        _parentDropdownOpen = true;
    }

    private void SelectParent(PageParentCandidateResponse? candidate)
    {
        _parentPageId = candidate?.Id;
        _parentSearch = ParentLabel(candidate);
        _parentDropdownOpen = false;
    }

    private async Task OnParentInputBlur()
    {
        // The dropdown's own option clicks use @onmousedown:preventDefault so they
        // land before this blur fires; the delay just covers the remaining paint frame.
        await Task.Delay(120);
        _parentSearch = ParentLabel(_parentCandidates.FirstOrDefault(c => c.Id == _parentPageId));
        _parentDropdownOpen = false;
        StateHasChanged();
    }

    private List<TagResponse> _tagCandidates = [];
    private List<int> _selectedTagIds = [];
    private string _tagSearch = "";
    private bool _tagDropdownOpen;
    private bool _creatingTag;

    private List<TagResponse> SelectedTags => [.. _tagCandidates.Where(t => _selectedTagIds.Contains(t.Id))];

    private List<TagResponse> FilteredTagCandidates => [.. _tagCandidates
        .Where(t => !_selectedTagIds.Contains(t.Id))
        .Where(t => string.IsNullOrWhiteSpace(_tagSearch) || t.Name.Contains(_tagSearch, StringComparison.OrdinalIgnoreCase))];

    private void OnTagSearchInput(ChangeEventArgs e)
    {
        _tagSearch = e.Value?.ToString() ?? "";
        _tagDropdownOpen = true;
    }

    private void SelectTag(TagResponse tag)
    {
        if (!_selectedTagIds.Contains(tag.Id))
            _selectedTagIds.Add(tag.Id);
        _tagSearch = "";
    }

    private void RemoveTag(int tagId) => _selectedTagIds.Remove(tagId);

    private async Task OnTagInputBlur()
    {
        await Task.Delay(120);
        _tagDropdownOpen = false;
        StateHasChanged();
    }

    private async Task CreateAndSelectTag()
    {
        if (_tagSearch.IsNullOrWhiteSpace() || _creatingTag) return;

        // A mouse click on this button fires BOTH mousedown and click (the pair is
        // needed so mouse and keyboard each work — see the markup). Clearing the
        // search text up front makes the second call a no-op, so one click can never
        // create the same tag twice.
        string name = _tagSearch;
        _tagSearch = "";
        _creatingTag = true;
        try
        {
            (await Sender.Send(new CreateTagCommand(name))).Match(
                tag =>
                {
                    if (_tagCandidates.All(t => t.Id != tag.Id))
                        _tagCandidates.Add(tag);
                    SelectTag(tag);
                },
                error =>
                {
                    // Put the text back so the editor can retry or correct it rather
                    // than having to retype the name they just lost.
                    _tagSearch = name;
                    Toast.Error(L.Error(error));
                });
        }
        finally { _creatingTag = false; }
    }

    private string? _gjsHtml;
    private string? _gjsCss;
    private string? _gjsData;

    // ── Unsaved-changes tracking ──────────────────────────────────────────────
    // A signature of everything SaveAll writes, captured on load and after each
    // successful save. Comparing against it beats tagging all ~20 bindings with a
    // dirty flag: nothing can be added to the form later and silently forgotten,
    // which is exactly how unsaved work went missing before.
    private string _savedSignature = "";

    // The canvas lives in an iframe, so Blazor never sees edits there. GrapesJS
    // pushes this flag in once per change-since-save (see OnEditorContentChanged).
    private bool _editorContentDirty;

    private bool IsDirty => _editorContentDirty || CurrentSignature() != _savedSignature;

    // ASCII Unit Separator: cannot occur in any of the joined values, so two
    // different field sets can never produce the same signature.
    private const char SignatureSeparator = '';

    private string CurrentSignature() => string.Join(SignatureSeparator,
        _title, _slug, _status, _parentPageId?.ToString() ?? "",
        string.Join(',', _selectedTagIds.Order()),
        string.Join(',', _excludedSiteCodeIds.Order()),
        _isCanonical, _canonicalUrl, _metaDescription, _metaAuthor, _noIndex, _noFollow, _kind, _focusKeyword,
        _structuredData, _social.Signature());

    /// <summary>Declares the current form state as "what's on the server".</summary>
    private void MarkSaved()
    {
        _savedSignature = CurrentSignature();
        _editorContentDirty = false;
    }

    /// <summary>
    /// GrapesJS reports the first canvas change after each save. Only the first is
    /// reported, so this is not a per-keystroke round trip.
    /// </summary>
    [JSInvokable]
    public Task OnEditorContentChanged()
    {
        _editorContentDirty = true;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Fills GrapesJS's "Select Image" dialog with the media library's images, so
    /// picking a picture for the page is one double-click instead of a trip to the
    /// media library to copy a URL out of it. Called by grapes-editor.js every time
    /// that dialog opens — an image uploaded elsewhere in the CMS is then already
    /// listed, without reloading the editor.
    /// </summary>
    [JSInvokable]
    public async Task<IReadOnlyList<MediaPickerAsset>> LoadMediaAssets()
    {
        try
        {
            // Images only: the dialog sets an <img src>, and offering a PDF there
            // would produce a broken image with no hint as to why.
            Result<PagedResult<MediaFileResponse>> result = await Sender.Send(
                new GetMediaFilesQuery(MediaType: MediaType.Image, Page: 1, PageSize: _mediaAssetLimit));

            if (result.IsFailure) return [];

            return MediaPickerProjection.ToPickerAssets(result.Value.Items);
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name);
            return [];
        }
    }

    /// <summary>
    /// How many library images the picker lists. The dialog is a scrolling grid with
    /// no paging of its own, so this is a deliberate ceiling rather than "all of them":
    /// a library of thousands would otherwise be serialised through interop on every open.
    /// </summary>
    private const int _mediaAssetLimit = 200;

    // ── Drag-and-drop image upload ────────────────────────────────────────────
    // Ceiling for a single dropped image, matching the media library's own manual
    // upload limit (MediaManager._maxUploadBytes) so the two paths can't disagree
    // about what is too big.
    private readonly long _maxDroppedImageBytes = 10_000_000;

    private bool _uploadingDroppedImage;

    /// <summary>
    /// Receives an image dropped onto the GrapesJS canvas (grapes-editor.js routes
    /// the file here), stores it through the SAME media-library pipeline as a manual
    /// upload, then asks the editor to insert the resulting URL at the drop point.
    /// </summary>
    private async Task HandleDroppedImage(InputFileChangeEventArgs e)
    {
        IBrowserFile? file = e.FileCount > 0 ? e.File : null;
        if (file is null) { await CancelDroppedImageAsync(); return; }

        if (file.Size > _maxDroppedImageBytes)
        {
            Toast.Error(string.Format(L["PageEditor_DropTooLarge"], _maxDroppedImageBytes / 1_000_000));
            await CancelDroppedImageAsync();
            return;
        }

        _uploadingDroppedImage = true;
        StateHasChanged();
        try
        {
            await using Stream content = file.OpenReadStream(_maxDroppedImageBytes);

            var request = new FileUploadRequest
            {
                FileName = file.Name,
                ContentType = file.ContentType,
                Content = content,
                FileSize = file.Size,
                // The file name is a far better starting alt text than an empty
                // string, and the editor can refine it from the Alt Text trait.
                AltText = Path.GetFileNameWithoutExtension(file.Name),
                Title = Path.GetFileNameWithoutExtension(file.Name)
            };

            FileResult? uploaded = null;
            (await Sender.Send(new CreateMediaFileCommand(request)))
                .Match(r => uploaded = r, error => Toast.Error(L.Error(error)));

            if (uploaded is null) { await CancelDroppedImageAsync(); return; }

            // Site-relative on purpose (see MediaPickerAsset): both apps serve
            // /uploads from the same shared volume, so this one path is correct in
            // the builder's canvas and on the public site alike — and, being
            // same-origin there, costs no extra DNS/TLS handshake to fetch.
            await JS.InvokeVoidAsync("grapesEditor.insertDroppedImage", uploaded.Url, uploaded.AltText);
            Toast.Success(L["PageEditor_DropUploaded"]);
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name);
            Toast.Error(L["PageEditor_DropUploadError"]);
            await CancelDroppedImageAsync();
        }
        finally
        {
            _uploadingDroppedImage = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Clears the editor-side in-flight guard so a failed drop doesn't make every
    /// subsequent drop silently do nothing.
    /// </summary>
    private async Task CancelDroppedImageAsync()
    {
        try { await JS.InvokeVoidAsync("grapesEditor.cancelDroppedImage"); }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
    }

    /// <summary>
    /// In-app navigation away from the editor. NavigationLock's own
    /// ConfirmExternalNavigation handles tab-close/reload but cannot carry a message;
    /// here we can name what is about to be lost.
    /// </summary>
    private async Task ConfirmLeavingUnsaved(LocationChangingContext context)
    {
        if (!IsDirty) return;

        bool leave;
        try
        {
            leave = await JS.InvokeAsync<bool>("cmsJs.confirmMessage", L["PageEditor_UnsavedWarning"]);
        }
        catch (Exception ex)
        {
            // If the prompt itself can't run, block the navigation: silently losing
            // the editor's work is the worse of the two failures.
            LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name);
            leave = false;
        }

        if (!leave) context.PreventNavigation();
    }

