    private async Task CreateTranslation(int targetLanguageId)
    {
        _creatingLanguageId = targetLanguageId;
        try
        {
            int? newPageId = null;
            (await Sender.Send(new CreatePageTranslationCommand(Id, targetLanguageId))).Match(
                id => newPageId = id,
                error => Toast.Error(L.Error(error)));

            if (newPageId is not null)
                Nav.NavigateTo($"/pages/edit/{newPageId}");
        }
        finally { _creatingLanguageId = null; }
    }

    private static string ScoreColor(int score)
    {
        if (score >= 80) return "var(--cms-success)";
        if (score >= 50) return "var(--cms-warning)";
        return "var(--cms-danger)";
    }

    // elevare-seo.js reports the score here on every (re-)analysis; the score badge
    // in the Blazor SEO panel previously only showed up on the GrapeJS toolbar and
    // never reached here.
    [JSInvokable]
    public Task OnSeoScoreUpdated(int score)
    {
        _seoScore = score;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Fired once per canvas load when this page holds one or more unlinked-template
    /// snapshots whose source has since changed. Informational only — the block on
    /// the page is intentionally left untouched (that's the point of not linking it).
    /// </summary>
    [JSInvokable]
    public void OnStaleTemplatesDetected(StaleTemplateInfo[] templates)
    {
        if (templates.Length == 0) return;
        _staleNotice?.Show(templates);
    }

