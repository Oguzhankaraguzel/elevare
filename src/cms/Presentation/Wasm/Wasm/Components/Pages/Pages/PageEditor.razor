        Result<AdjacentPreviewResponse> result = await Sender.Send(new GetAdjacentPreviewQuery(Id));
        return result.IsSuccess ? result.Value : null;
    }

    /// <summary>
    /// The code block's colours for the canvas — the same highlighter the public
    /// site runs, so what the editor shows is what ships. An instance method because
    /// the canvas reaches it through this editor's object reference.
    /// </summary>
    [JSInvokable]
    public string HighlightCode(string? code, string? language) =>
        SharedKernel.Content.CodeHighlighter.Highlight(code ?? "", language);

    /// <summary>
    /// Keeps the SEO analyser in step with the structured data panel, so the score
    /// reacts to a draft being built or a node being removed without waiting for a save.
    /// </summary>
    private async Task OnStructuredDataChanged(string? value)
    {
        _structuredData = value;
        await PushSeoMetaToJs();
    }

    // The share tags exactly as the page will write them — nothing is filled in on
    // the public site any more, so the analysis judges what the fields say.
    private object SocialSeoMeta => new
    {
        title = _social.OgTitle ?? "",
        description = _social.OgDescription ?? "",
        image = _social.OgImage ?? "",
        imageWidth = _social.Meta.ImageWidth ?? 0,
        imageHeight = _social.Meta.ImageHeight ?? 0,
        imageAlt = _social.Meta.ImageAlt ?? "",
        url = _social.OgUrl ?? "",
    };

    // The address the page is served at — what og:url and the structured data's
    // own addresses should say. Empty when the site's address is not set.
    private string PageAddress => SocialSuggestions.PageLink ?? "";

    private async Task PushSeoMetaToJs()
    {
        try
        {
            await JS.InvokeVoidAsync("grapesEditor.updateSeoMeta",
                new
                {
                    focusKeyword = _focusKeyword,
                    metaDescription = _metaDescription,
                    structuredData = _structuredData ?? "",
                    // The analyser has always had a pageTitle slot; nothing ever
                    // filled it, so its title checks could never run.
                    pageTitle = _title ?? "",
                    titleSuffix = EffectiveTitleSuffix,
                    social = SocialSeoMeta,
                    pageUrl = PageAddress,
                });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
    }

    private async Task ReanalyzeSeo()
    {
        try { await JS.InvokeVoidAsync("grapesEditor.reanalyzeSeo"); }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
    }

    // Pastes raw HTML/CSS into the canvas (into the selected component, or the
    // page root if nothing is selected) via GrapesJS's own setComponents/addRules
    // APIs — the same insertHtml bridge the Template panel's "Add to editor"
    // button already uses. CustomCodeGuard still re-validates on Save, this modal
    // is just gated up front so only Developer/Admin/SuperAdmin ever see it.
    private async Task ImportCode()
    {
        if (string.IsNullOrWhiteSpace(_importHtml)) return;
        try
        {
            await JS.InvokeVoidAsync("grapesEditor.insertHtml", _importHtml, _importCss);
            _importCodeOpen = false;
            _importHtml = "";
            _importCss = "";
            Toast.Success(L["PageEditor_ImportCodeImported"]);
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name);
            Toast.Error(L["PageEditor_ImportCodeError"]);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_loading && !_notFound && !_editorInitStarted)
        {
            _editorInitStarted = true;
            try
            {
                _dotNetRef?.Dispose();
                _dotNetRef = DotNetObjectReference.Create(this);
                // Must precede init(): the blocks read this synchronously while they
                // are being registered, which happens inside init().
                await JS.InvokeVoidAsync("grapesEditor.setSiteInfo",
                    new
                    {
                        mapEmbedUrl = _mapEmbedUrl ?? "",
                        workingHours = _workingHours ?? "",
                        logoUrl = _logoUrl ?? "",
                        logoAlt = _logoAlt ?? "",
                        siteName = _siteName ?? "",
                        publicSiteHost = PublicSiteHost(_publicSiteBaseUrl),
                        // What text a block writes INTO the page is in — the page's
                        // language, not the CMS's.
                        pageLanguage = _languages.FirstOrDefault(l => l.Id == _currentLanguageId)?.TwoLetterCode ?? "",
                        contact = _contact
                    });
                // Also before init(): the canvas's Site Codes stylesheet URL is built
                // from this when the canvas is created.
                await JS.InvokeVoidAsync("grapesEditor.setExcludedSiteCodes", _excludedSiteCodeIds.ToArray());
                bool ok = await JS.InvokeAsync<bool>("grapesEditor.init", "gjs", _gjsHtml, _gjsCss, _gjsData, _linkedTemplates,
                    new { metaDescription = _metaDescription, focusKeyword = _focusKeyword, structuredData = _structuredData ?? "", pageTitle = _title ?? "", titleSuffix = EffectiveTitleSuffix, social = SocialSeoMeta, pageUrl = PageAddress },
                    BuildSeoResources(), _dotNetRef,
                    // flagUrl/flagAlt feed the Language Switcher block's flag mode —
                    // the icon picked per language on the Diller screen, which until
                    // now never left the CMS.
                    //
                    // IsPublished as well as IsActive, matching what the public site
                    // will actually resolve: LanguageSwitcherResolutionService only
                    // rewrites slots for PubliclyVisible languages (active AND
                    // published). Sending an active-but-unpublished language put an
                    // <a href="#"> in the switcher that nothing ever resolved — a
                    // permanent dead link on the live page.
                    _languages.Where(l => l.IsActive && l.IsPublished).Select(l => new
                    {
                        code = l.TwoLetterCode,
                        isDefault = l.IsDefault,
                        flagUrl = l.FlagIconPath ?? "",
                        flagAlt = l.FlagIconAltText ?? l.NameInNative
                    }),
                    // Feeds the builder's page pickers — "Site sayfası" on a link, the
                    // Sayfa Listesi block's "Kaynak Sayfa" — every page of this language.
                    _pageDirectory.Select(c => new { id = c.Id, label = c.FullSlug, title = c.Title }),
                    _templateVersions.ToDictionary(
                        kv => kv.Key.ToString(),
                        kv => new { name = kv.Value.Name, version = kv.Value.Version }));
                _editorReady = ok;
            }
            catch (Exception ex)
            {
                LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> SaveAll()
    {
        if (_title.IsNullOrWhiteSpace()) { Toast.Error(L["Pages_Validation_Title"]); return false; }
        if (_slug.IsNullOrWhiteSpace()) { _slug = _title.ToSlug(); }

        // A Published page's old URL only auto-redirects (see RedirectResolution on
        // the server) if the editor actually goes through with the rename — ask first,
        // since it's a one-way, visitor-facing change the user might not expect.
        if (_originalStatus == PageStatus.Published && _slug.ToSlug() != _originalSlug && !_slugChangeConfirmed)
        {
            _showSlugChangeConfirm = true;
            return false;
        }

        _saving = true;
        try
        {
            GjsResult? gjs = null;
            try
            {
                gjs = await JS.InvokeAsync<GjsResult?>("grapesEditor.getData");
            }
            catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

            // null means the canvas could not be read — the interop call failed
            // (a dropped circuit, a timeout) or the editor never finished loading.
            // Continuing would hand UpdatePageCommand null Html/Css/Data, and it
            // writes exactly that: the page's content is wiped while the user is
            // told the save succeeded. There is nothing to save here, so refuse.
            if (gjs is null)
            {
                Toast.Error(L["PageEditor_ContentUnavailable"]);
                return false;
            }

            var seo = new UpdatePageSeoMeta(
                _isCanonical,
                _canonicalUrl,
                _metaDescription,
                _metaAuthor,
                _noIndex,
                _noFollow,
                _focusKeyword,
                _structuredData,
                _social.OgTitle,
                _social.OgDescription,
                _social.OgType,
                _social.OgImage,
                _social.OgUrl,
                _social.TwitterCard,
                _social.TwitterSite,
                _seoScore,
                _social.Meta);

            bool ok = false;
            bool overwrite = _overwriteNext;
            _overwriteNext = false;
            (await Sender.Send(new UpdatePageCommand(
                    Id, _title.Trim(), _slug, _status, gjs.Html, gjs.Css, gjs.Data, seo, _parentPageId, _selectedTagIds, _kind,
                    [.. _excludedSiteCodeIds], _fingerprint, overwrite)))
                .Match(() => ok = true, error =>
                {
                    if (error.Code == PageInfoErrors.EditedElsewhere.Code)
                        _showEditConflict = true;
                    else
                        Toast.Error(L.Error(error));
                });

            if (ok)
            {
                // The command itself only reports success/failure, not whether an
                // active workflow held the status back — re-fetch to learn that,
                // the same way the editor learns it on first load.
                _pendingStatus = null;
                string previousFullSlug = _fullSlug;
                PageEditorResponse? saved = null;
                try
                {
                    // The address too: a new slug or parent moves the page, and
                    // "Otomatik doldur" and the SEO check must use where it is now.
                    (await Sender.Send(new GetPageByIdQuery(Id))).Match(
                        fresh =>
                        {
                            saved = fresh;
                            _pendingStatus = fresh.PendingStatus;
                            _fullSlug = fresh.FullSlug;
                            _fingerprint = fresh.Fingerprint;
                        },
                        _ => { });
                }
                catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

                Toast.Success(_pendingStatus.HasValue
                    ? L["PageEditor_SavedPendingApproval"]
                    : L["PageEditor_Saved"]);

                // A move rewrote this page's og:url, structured data and any links in
                // it on the server: load that back, or the next save would put the
                // old addresses right back.
                if (_fullSlug != previousFullSlug && saved is not null)
                {
                    Toast.Info(L["PageEditor_AddressChangedLinksMoved"]);
                    await ReloadEditorAsync(saved);
                }
                _slug = _slug.ToSlug();
                _originalSlug = _slug;
                _originalStatus = _status;
                _slugChangeConfirmed = false;

                // The server now holds exactly this state — clear the guard, and tell
                // GrapesJS to start reporting canvas changes again from here.
                MarkSaved();
                try { await JS.InvokeVoidAsync("grapesEditor.markClean"); }
                catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
            }

            return ok;
        }
        finally { _saving = false; }
    }

    private async Task ReloadAfterConflict()
    {
        _showEditConflict = false;
        PageEditorResponse? current = null;
        try
        {
            (await Sender.Send(new GetPageByIdQuery(Id))).Match(page => current = page, error => Toast.Error(L.Error(error)));
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
        if (current is not null)
            await ReloadEditorAsync(current);
    }

    private async Task OverwriteAfterConflict()
    {
        _showEditConflict = false;
        _overwriteNext = true;
        await SaveAll();
    }

    /// <summary>The linked templates' current content, which the canvas shows inside every template block.</summary>
    private async Task LoadTemplatesAsync()
    {
        try
        {
            (await Sender.Send(new GetLinkedPageTemplatesContentQuery())).Match(
                map => _linkedTemplates = map,
                _ => { });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

        try
        {
            (await Sender.Send(new GetPageTemplateVersionsQuery())).Match(
                map => _templateVersions = map,
                _ => { });
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
    }

    /// <summary>Replaces what the editor holds with the page as saved, canvas included.</summary>
    private async Task ReloadEditorAsync(PageEditorResponse page)
    {
        Apply(page);
        // A move rewrites links inside the templates too.
        await LoadTemplatesAsync();
        _originalSlug = _slug;
        _slugChangeConfirmed = false;
        try { await JS.InvokeVoidAsync("grapesEditor.destroy"); }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }
        _editorReady = false;
        // OnAfterRenderAsync builds the canvas again from the content Apply just set.
        _editorInitStarted = false;
        MarkSaved();
        await InvokeAsync(StateHasChanged);
    }

    private void CancelSlugChangeConfirm()
    {
        _slug = _originalSlug;
        _showSlugChangeConfirm = false;
    }

    private async Task ConfirmSlugChangeAndSave()
    {
        _slugChangeConfirmed = true;
        _showSlugChangeConfirm = false;
        await SaveAll();
    }

    private async Task Preview()
    {
        string handle = await JS.InvokeAsync<string>("cmsJs.openPendingWindow");

        GjsResult? gjs = null;
        try
        {
            gjs = await JS.InvokeAsync<GjsResult?>("grapesEditor.getData");
        }
        catch (Exception ex) { LoggerFactory.CreateLogger(GetType()).LogError(ex, "Unhandled error in {Component}.", GetType().Name); }

        // Same reasoning as SaveAll: an unreadable canvas would stage null content,
        // and the preview tab would open on a blank page as if that were the work.
        if (gjs is null)
        {
            Toast.Error(L["PageEditor_ContentUnavailable"]);
            await JS.InvokeVoidAsync("cmsJs.navigatePendingWindow", handle, "about:blank");
            return;
        }

        // Stages the editor's current (possibly unsaved) content into the preview
        // snapshot columns only — this never touches the live Gjs/Title/Slug/Status
        // fields, so an already-Published page's real visitors see no change.
        bool staged = false;
        (await Sender.Send(new SavePreviewContentCommand(Id, gjs.Html, gjs.Css)))
            .Match(() => staged = true, error => Toast.Error(L.Error(error)));

        if (!staged)
        {
            await JS.InvokeVoidAsync("cmsJs.navigatePendingWindow", handle, "about:blank");
            return;
        }

        string? url = null;
        (await Sender.Send(new GetPreviewLinkQuery(Id))).Match(
            u => url = u,
            error => Toast.Error(L.Error(error)));

        await JS.InvokeVoidAsync("cmsJs.navigatePendingWindow", handle, url ?? "about:blank");
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("grapesEditor.destroy"); }
        catch { /* circuit may already be gone */ }
        _dotNetRef?.Dispose();
    }
