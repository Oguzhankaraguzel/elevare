    // Mirrors the public layout's "{title} - {suffix}" rule (_Layout.cshtml): the
    // SEO settings' title suffix when set, otherwise the site name, otherwise the
    // built-in fallback. The SEO analyser uses this to judge the real title.
    private string EffectiveTitleSuffix
    {
        get
        {
            string suffix = (_metaTitleSuffix ?? "").Trim();
            if (suffix.Length > 0) return suffix;
            string name = (_siteName ?? "").Trim();
            return name.Length > 0 ? name : "Elevare";
        }
    }
    // What "Otomatik doldur" offers in the Social Sharing panel — see SocialShareSuggestions.
    private string? _defaultMetaDescription;
    private string? _defaultShareImage;
    private string? _xProfileUrl;
    private string? _publicSiteBaseUrl;
    private string _fullSlug = "";

    private SocialShareSuggestions SocialSuggestions
    {
        get
        {
            string? baseUrl = _publicSiteBaseUrl?.Trim().TrimEnd('/');
            // og:url is the custom canonical when there is one, else the page's own address.
            string? pageUrl = null;
            if (!string.IsNullOrWhiteSpace(_canonicalUrl))
                pageUrl = _canonicalUrl.Trim();
            else if (!string.IsNullOrWhiteSpace(baseUrl))
                pageUrl = $"{baseUrl}/{_fullSlug}".TrimEnd('/');
            return new SocialShareSuggestions(
                _defaultMetaDescription,
                _defaultShareImage,
                SocialProfiles.XHandle(_xProfileUrl),
                SocialShareSuggestions.OgLocale(_languages.FirstOrDefault(l => l.Id == _currentLanguageId)?.TwoLetterCode),
                pageUrl,
                _audit?.PublishedAt,
                [.. SelectedTags.Select(t => t.Name).Order(StringComparer.CurrentCulture)]);
        }
    }

