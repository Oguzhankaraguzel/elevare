@page "/users/create"
@page "/users/edit/{Id:guid}"
@layout CMSLayout

<CmsPageTitle>@(_isEdit? L["UserEdit_PageTitleEdit"] : L["UserEdit_PageTitleCreate"])</CmsPageTitle>

<div class="cms-breadcrumb">
    <a href="/users"><i class="bi bi-people"></i> @L["UserEdit_BreadcrumbUsers"]</a>
    <i class="bi bi-chevron-right"></i>
    <span>@(_isEdit? L["Common_Edit"] : L["UserEdit_HeaderCreate"])</span>
</div>

<div class="page-header">
    <h1>@(_isEdit? L["UserEdit_HeaderEdit"] : L["UserEdit_HeaderCreate"])</h1>
</div>

<div style="display:grid;grid-template-columns:1fr 320px;gap:20px;align-items:start">

    <div class="cms-card">
        <EditForm Model="_model" OnValidSubmit="Save" FormName="user-form">
            <DataAnnotationsValidator />

            <div class="form-row cols-2">
                <div class="form-group">
                    <label class="cms-label">@L["UserEdit_FirstName"]</label>
                    <InputText @bind-Value="_model.FirstName" class="cms-input" @onfocusout="CorrectName" placeholder="@L["UserEdit_FirstNamePlaceholder"]" />
                </div>
                <div class="form-group">
                    <label class="cms-label">@L["UserEdit_LastName"]</label>
                    <InputText @bind-Value="_model.LastName" class="cms-input" @onfocusout="CorrectSurname" placeholder="@L["UserEdit_LastNamePlaceholder"]" />
                </div>
            </div>

            <div class="form-group">
                <label class="cms-label">@L["UserEdit_Email"] <span style="color:var(--cms-danger)">*</span></label>
                <InputText @bind-Value="_model.Email" class="cms-input" placeholder="@L["UserEdit_EmailPlaceholder"]"
                           type="email" disabled="@_isEdit" />
                <ValidationMessage For="() => _model.Email" style="color:var(--cms-danger);font-size:12px" />
            </div>

                <div class="form-group">
                    <label class="cms-label">@L["UserEdit_UserName"] <span style="color:var(--cms-danger)">*</span></label>
                    <InputText @bind-Value="_model.UserName" class="cms-input" placeholder="@L["UserEdit_UserNamePlaceholder"]"
                               disabled="@_isEdit" />
                    @if (CanUsernameBeCreated())
                    {
                        <button type="button" class="mt-1 btn-cms btn-ghost" disabled="@_saving" @onclick="GenerateUserName">@L["UserEdit_GenerateUserName"]</button>
                    }
                    <ValidationMessage For="() => _model.UserName" style="color:var(--cms-danger);font-size:12px" />
                </div>

            @if (!_isEdit && _emailConfigured is bool mailReady)
            {
                @* Said before the save, not after: without a mail server the link is the
                   administrator's to deliver, and they should know that going in. *@
                @if (mailReady)
                {
                    <div class="cms-callout" style="margin-bottom:18px;padding:12px 14px;border:1px solid var(--cms-border);border-radius:6px;display:flex;gap:10px;align-items:flex-start">
                        <i class="bi bi-envelope-check" style="color:var(--cms-accent);font-size:16px;margin-top:1px"></i>
                        <small style="color:var(--cms-text-muted)">@L["UserEdit_PasswordEmailNotice"]</small>
                    </div>
                }
                else
                {
                    <div class="pw-link-note is-warning" style="margin-bottom:18px">
                        <i class="bi bi-envelope-slash"></i>
                        <span>@L["UserEdit_PasswordNoMailNotice"]</span>
                    </div>
                }
            }

            <div class="form-group">
                <label class="cms-label">@L["UserEdit_Bio"]</label>
                <InputTextArea @bind-Value="_model.Bio" class="cms-textarea" rows="3" placeholder="@L["UserEdit_BioPlaceholder"]" />
            </div>

            <div style="display:flex;gap:10px;margin-top:8px">
                <button type="submit" class="btn-cms btn-primary-cms" disabled="@_saving">
                    @if (_saving)
                    {
                        <i class="bi bi-arrow-clockwise spin"></i>
                    }
                    else
                    {

                        <i class="bi bi-check2"></i>
                    }
                    @(_isEdit? L["UserEdit_UpdateBtn"] : L["UserEdit_SaveBtn"])
                </button>
                <a href="/users" class="btn-cms btn-ghost">@L["UserEdit_CancelBtn"]</a>
            </div>
        </EditForm>
    </div>

    <div>
        <div class="cms-card">
            <div class="cms-card-header"><h5>@L["UserEdit_RoleStatus"]</h5></div>
            <div class="form-group">
                <label class="cms-label">@L["UserEdit_RoleLabel"]</label>
                <select @bind="_model.Role" class="cms-select">
                    <option value="">@L["UserEdit_SelectRole"]</option>
                    @foreach (RoleResponse role in _roles)
                    {
                        <option value="@role.Name">@RoleDisplayName(role)</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label style="display:flex;align-items:center;gap:10px;cursor:pointer">
                    <label class="cms-toggle">
                        <InputCheckbox @bind-Value="_model.IsActive" />
                        <span class="cms-toggle-slider"></span>
                    </label>
                    <span style="color:var(--cms-text-muted)">@L["UserEdit_AccountActive"]</span>
                </label>
            </div>
        </div>
    </div>
</div>

<CmsModal Title="@L["PasswordLink_CreatedTitle"]" IsVisible="_createdLink is not null" OnClose="FinishCreate" Size="md">
    <Body>
        @if (_createdLink is { SetupUrl: { } url } created)
        {
            <PasswordLinkShare Url="@url" ExpiresAtUtc="created.LinkExpiresAtUtc"
                               UserName="@($"{_model.FirstName} {_model.LastName}".Trim())"
                               EmailFailed="_emailConfigured == true" />
        }
    </Body>
    <Footer>
        <button class="btn-cms btn-primary-cms" @onclick="FinishCreate">@L["PasswordLink_Done"]</button>
    </Footer>
</CmsModal>

@code {
    [Parameter] public Guid? Id { get; set; }

    /// <summary>Null until known, so neither notice flashes up before the answer is in.</summary>
    private bool? _emailConfigured;

    /// <summary>A just-created account whose setup link was not mailed — shown once, then gone.</summary>
    private CreateUserResult? _createdLink;

    private UserFormModel _model = new();
    /// <summary>Role the user had when the form loaded, to detect an actual change on save.</summary>
    private string _originalRole = "";
    private List<RoleResponse> _roles = []; 
    private bool _saving;
    private bool _isEdit => Id.HasValue;

    // Built-in roles keep their existing localized labels; SuperAdmin-created
    // custom roles (see /admin/roles) have no resx entry, so their raw name is
    // the only sensible display — it's also literally what UserManager stores.
    private string RoleDisplayName(RoleResponse role) => role.Name switch 
    {
        "SuperAdmin" => L["Roles_SuperAdmin"],
        "Admin" => L["Roles_Admin"],
        "Developer" => L["Roles_Developer"],
        "Editor" => L["Roles_Editor"],
        "Author" => L["Roles_Author"],
        "Viewer" => L["Roles_Viewer"],
        _ => role.Name,
    };

    private bool CanUsernameBeCreated()
    {
        if (_isEdit) return false;

        bool firstValid = !string.IsNullOrWhiteSpace(_model.FirstName) && _model.FirstName!.Length > 3;
        bool lastValid = !string.IsNullOrWhiteSpace(_model.LastName) && _model.LastName!.Length > 3;

        return firstValid || lastValid;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserContext.HasPermission(PermissionKeys.UsersManage))
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        if (!_isEdit)
            (await Sender.Send(new GetEmailStatusQuery())).Match(configured => _emailConfigured = configured, _ => { });

        (await Sender.Send(new GetRolesQuery())).Match(
            list => _roles = list,
            error => Toast.Error(L.Error(error)));

        if (_isEdit)
        {
            SharedKernel.Concrete.Result<PagedResult<UserResponse>> r =
                await Sender.Send(new GetUsersQuery(Id: Id));
            UserResponse? user = r.IsSuccess ? r.Value.Items.FirstOrDefault() : null;
            if (user is null)
            {
                Toast.Error(L["UserEdit_Toast_NotFound"]);
                Nav.NavigateTo("/users");
                return;
            }
            _model = new UserFormModel
            {
                Email = user.Email ?? "",
                UserName = user.UserName ?? "",
                FirstName = user.FirstName,
                LastName = user.LastName,
                Bio = user.Bio,
                Role = user.Roles.FirstOrDefault() ?? "",
                IsActive = user.IsActive
            };
            _originalRole = _model.Role;
        }
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            if (_isEdit)
            {
                var cmd = new UpdateUserCommand(Id!.Value, _model.FirstName, _model.LastName,
                    _model.Bio, _model.Role, _model.IsActive);
                Result r = await Sender.Send(cmd);
                if (r.IsSuccess)
                {
                    Toast.Success(L["UserEdit_Toast_Updated"]);
                    if (!string.Equals(_originalRole, _model.Role, StringComparison.Ordinal))
                        Toast.Warning(L["UserEdit_RoleChangeNeedsReLogin"]);
                    Nav.NavigateTo("/users");
                }
                else Toast.Error(L.Error(r.Error));
            }
            else
            {
                var cmd = new CreateUserCommand(_model.Email, _model.UserName,
                    _model.FirstName, _model.LastName, _model.Bio, _model.Role, Nav.BaseUri, _model.IsActive);
                Result<CreateUserResult> r = await Sender.Send(cmd);
                if (r.IsSuccess)
                {
                    Toast.Success(L["UserEdit_Toast_Created"]);
                    // No mail went out: the link is shown here, the only place it ever
                    // exists in readable form, before leaving the page.
                    if (r.Value.SetupUrl is not null)
                        _createdLink = r.Value;
                    else
                        Nav.NavigateTo("/users");
                }
                else Toast.Error(L.Error(r.Error));
            }
        }
        finally { _saving = false; }
    }

    private void FinishCreate()
    {
        _createdLink = null;
        Nav.NavigateTo("/users");
    }

    private void GenerateUserName()
    {
        if (_model.FirstName.IsNullOrWhiteSpace() && _model.LastName.IsNullOrWhiteSpace()) return;
        _model.UserName = SpectraUtil.NameEdit.CreateUserNameFrom(_model.FirstName, _model.LastName);
    }

    private void CorrectName()
    {
        _model.FirstName = SpectraUtil.NameEdit.CorrectGivenNames(_model.FirstName);
    }
    private void CorrectSurname()
    {
        _model.LastName = SpectraUtil.NameEdit.CorrectSurnames(_model.LastName);
    }

    }
