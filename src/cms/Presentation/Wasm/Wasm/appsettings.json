{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "SeqUrl": "",
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ElevareDB;Username=postgres;Password=postgres;"
  },
  "Jwt": {
    "Issuer": "https://localhost",
    "Audience": "https://localhost",
    "SecretKey": ""
  },
  "Preview": {
    "SigningKey": ""
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromDisplayName": "CMS",
    "TemplatesFolder": "EmailTemplates",
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 500
  },
  "FileStorage": {
    "UploadFolder": "uploads",
    "MaxFileSizeBytes": 52428800,
    "OrganizeByDate": true,
    "AllowedMimeTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "image/svg+xml",
      "image/bmp",
      "image/x-icon",
      "image/vnd.microsoft.icon",
      "video/mp4",
      "video/webm",
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "text/plain",
      "text/csv",
      "audio/mpeg",
      "audio/wav"
    ]
  },
  "ObjectStorage": {
    "Provider": "Local",
    "BucketName": "",
    "Region": "",
    "AccessKey": "",
    "SecretKey": "",
    "ServiceUrl": "",
    "PublicBaseUrl": ""
  },
  "Backup": {
    "Directory": "",
    "KeepCount": 8,
    "TimeoutMinutes": 60,
    "VerifyAfterBackup": true
  },
  "Retention": {
    "AnalyticsDays": 90,
    "LogDays": 90,
    "BatchSize": 5000
  },
  "Cache": {
    "ClearSecret": ""
  },
  "Seed": {
    "SuperAdmin": {
      "UserName": "",
      "Email": "",
      "Password": ""
    },
    "Editor": {
      "UserName": "",
      "Email": "",
      "Password": ""
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "TrustForwardedForHeader": false,
    "WindowSeconds": 300,
    "LoginPermitLimit": 20
  }
}
